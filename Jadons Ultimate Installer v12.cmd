function thought(e){
 const where=`Turn ${e.turn??'?'} | ${e.phase??'unknown phase'}`
 if(e.type==='decision_start')return['SCAN',`${where}: comparing ${e.candidates??'several'} legal actions from a position score of ${e.score??'?'}.`,'']
