function render(){
 const names=[...new Set(S.events.map(e=>e.player).filter(Boolean))].sort(),selector=$('pilotFilter'),signature=names.join('\n');if(selector.dataset.signature!==signature){const selected=selector.value;selector.replaceChildren(new Option('All AI pilots','all'),...names.map(name=>new Option(name,name)));selector.value=names.includes(selected)?selected:'all';selector.dataset.signature=signature}const ev=selector.value==='all'?S.events:S.events.filter(e=>e.player===selector.value),last=[...ev].reverse().find(e=>e.player),choices=ev.filter(e=>['planned','heuristic_chosen','simulation_best'].includes(e.type))
 $('pilot').textContent=last?.player||'Computer AI';$('decisions').textContent=ev.filter(e=>['decision_start','heuristic_start'].includes(e.type)).length||choices.length
