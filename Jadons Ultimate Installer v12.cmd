)
if not exist "%GAME_DIR%" mkdir "%GAME_DIR%" >nul 2>&1
xcopy "%GAME_CAND%\*" "%GAME_DIR%\" /E /I /Y >nul 2>&1
if errorlevel 1 exit /b 1
call :UD_WRITE_GAME_VSCODE
call :UD_CREATE_GAME_LAUNCHERS
