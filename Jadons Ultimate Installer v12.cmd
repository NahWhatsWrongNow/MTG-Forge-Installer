set "ABM_RUNTIME=%ABM_ROOT%\runtime"
set "ABM_DATA=%ABM_ROOT%\data"
set "ABM_LOGS=%ABM_ROOT%\logs"
set "ABM_BACKUPS=%ABM_ROOT%\backups"
set "ABM_LOG=%ABM_LOGS%\abm-manager.log"
set "ABM_MANIFEST=%ABM_ROOT%\version-manifest.txt"
set "ABM_LOCATION=%ABM_FORGE_BASE%\ABettingMan_Location.txt"
set "ABM_LAUNCHER=%ABM_ROOT%\Launch_A_Betting_Man.cmd"

if /I "%~1"=="--selftest" goto :ABM_SELFTEST
if /I "%~1"=="--install-test" goto :ABM_INSTALL_TEST
call :ABM_INIT
if errorlevel 1 goto :ABM_FATAL
call :ABM_PREPARE_APP
if errorlevel 1 (
  echo.
  echo A Betting Man could not prepare a validated application candidate.
  echo The previous working copy and every campaign database were retained.
  echo Log: %ABM_LOG%
  pause
)
goto :ABM_MENU_ONE

:ABM_HEADER
cls
echo.
echo ================================================================================
echo   A BETTING MAN  ^|  COMMANDER CAMPAIGN  ^|  v%ABM_VERSION%
echo ================================================================================
echo   Choose. Build. Play. Discover your next advantage.
echo   Guided play, saved packs, and automatic reward choices.
echo   Data: %ABM_DATA%
echo.
exit /b 0

:ABM_MENU_ONE
call :ABM_HEADER
echo   CAMPAIGN
echo   [1] Create Campaign
echo   [2] Continue Campaign
echo   [3] How to Play - a guided five-step introduction
echo.
echo   DISCOVER AND BUILD
echo   [4] Commander Discovery
echo   [5] Random Restrictions
echo   [6] Inventory and Packs
echo   [7] Deck Builder
echo.
echo   [8] Next Page
echo   [9] Repair A Betting Man
echo   [0] Return to Jadon's Ultimate Installer
echo.
choice /C 1234567890 /N /M "Choose 0-9: "
set "ABM_CHOICE=%ERRORLEVEL%"
if "%ABM_CHOICE%"=="10" goto :ABM_END
if "%ABM_CHOICE%"=="9" goto :ABM_REPAIR
if "%ABM_CHOICE%"=="8" goto :ABM_MENU_TWO
if "%ABM_CHOICE%"=="7" call :ABM_OPEN_PAGE decks
if "%ABM_CHOICE%"=="6" call :ABM_OPEN_PAGE collection
if "%ABM_CHOICE%"=="5" call :ABM_OPEN_PAGE restrictions
if "%ABM_CHOICE%"=="4" call :ABM_OPEN_PAGE commanders
if "%ABM_CHOICE%"=="3" call :ABM_OPEN_PAGE help
if "%ABM_CHOICE%"=="2" call :ABM_OPEN_PAGE dashboard
if "%ABM_CHOICE%"=="1" call :ABM_OPEN_PAGE setup
goto :ABM_MENU_ONE

:ABM_MENU_TWO
call :ABM_HEADER
echo   MATCH AND PROGRESSION
echo   [1] Betting Table
echo   [2] Forge Match Centre
echo   [3] Upgrade Workshop
echo   [4] Player Wallets
echo.
echo   ECONOMY AND SEASON
echo   [5] Trading and Crafting
echo   [6] Contracts and Gauntlet
echo   [7] Settings
echo.
echo   [8] Next Page
echo   [9] Previous Page
echo   [0] Return to Jadon's Ultimate Installer
echo.
choice /C 1234567890 /N /M "Choose 0-9: "
set "ABM_CHOICE=%ERRORLEVEL%"
if "%ABM_CHOICE%"=="10" goto :ABM_END
if "%ABM_CHOICE%"=="9" goto :ABM_MENU_ONE
if "%ABM_CHOICE%"=="8" goto :ABM_MENU_THREE
if "%ABM_CHOICE%"=="7" call :ABM_OPEN_PAGE settings
if "%ABM_CHOICE%"=="6" call :ABM_OPEN_PAGE contracts
if "%ABM_CHOICE%"=="5" call :ABM_OPEN_PAGE market
if "%ABM_CHOICE%"=="4" call :ABM_OPEN_PAGE dashboard
if "%ABM_CHOICE%"=="3" call :ABM_OPEN_PAGE workshop
if "%ABM_CHOICE%"=="2" call :ABM_OPEN_PAGE betting
if "%ABM_CHOICE%"=="1" call :ABM_OPEN_PAGE betting
goto :ABM_MENU_TWO

:ABM_MENU_THREE
call :ABM_HEADER
echo   ADMINISTRATION AND RECOVERY
echo   [1] Host Console
echo   [2] Diagnostics
echo   [3] Open Folders
echo   [4] Backup Campaign Database
echo   [5] Restore Campaign Database
echo   [6] View Version Manifest
echo   [7] Stop Local Campaign Service
echo.
echo   [8] Previous Page
echo   [9] First Page
echo   [0] Return to Jadon's Ultimate Installer
echo.
choice /C 1234567890 /N /M "Choose 0-9: "
set "ABM_CHOICE=%ERRORLEVEL%"
if "%ABM_CHOICE%"=="10" goto :ABM_END
if "%ABM_CHOICE%"=="9" goto :ABM_MENU_ONE
if "%ABM_CHOICE%"=="8" goto :ABM_MENU_TWO
if "%ABM_CHOICE%"=="7" call :ABM_STOP_SERVER
if "%ABM_CHOICE%"=="6" call :ABM_SHOW_MANIFEST
if "%ABM_CHOICE%"=="5" call :ABM_RESTORE
if "%ABM_CHOICE%"=="4" call :ABM_BACKUP
if "%ABM_CHOICE%"=="3" call :ABM_OPEN_FOLDERS
if "%ABM_CHOICE%"=="2" call :ABM_DIAGNOSTICS
if "%ABM_CHOICE%"=="1" call :ABM_HOST_CONSOLE
goto :ABM_MENU_THREE

:ABM_INIT
for %%D in ("%ABM_ROOT%" "%ABM_PROGRAM%" "%ABM_RUNTIME%" "%ABM_DATA%" "%ABM_LOGS%" "%ABM_BACKUPS%") do if not exist "%%~D" mkdir "%%~D" >nul 2>&1
if not exist "%ABM_ROOT%" exit /b 1
if not exist "%ABM_DATA%" exit /b 1
>>"%ABM_LOG%" echo.
>>"%ABM_LOG%" echo [%DATE% %TIME%] A Betting Man manager v%ABM_VERSION% started.
exit /b 0

:ABM_PREPARE_APP
if defined ABM_FORCE goto :ABM_PREPARE_REFRESH
call :ABM_VERIFY_CURRENT
if not errorlevel 1 exit /b 0
:ABM_PREPARE_REFRESH
call :ABM_FIND_NODE
if not defined ABM_NODE call :ABM_INSTALL_NODE
if errorlevel 1 (
  >>"%ABM_LOG%" echo Node 22 or newer with built-in SQLite could not be prepared.
  exit /b 1
)
set "ABM_ZIP=%ABM_RUNTIME%\ABettingMan-v12.candidate.zip"
set "ABM_CANDIDATE=%ABM_PROGRAM%\candidate-v12"
if exist "%ABM_ZIP%" del /q "%ABM_ZIP%" >nul 2>&1
if exist "%ABM_CANDIDATE%" rmdir /s /q "%ABM_CANDIDATE%" >nul 2>&1
set "PS_ABM_SELF=%ABM_SELF%"
set "PS_ABM_ZIP=%ABM_ZIP%"
set "PS_ABM_SHA=%ABM_ZIP_SHA%"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$r=[IO.File]::ReadAllText($env:PS_ABM_SELF);$b='###JADON_ABM_APP_ZIP_BEGIN###';$e='###JADON_ABM_APP_ZIP_END###';$bi=$r.LastIndexOf($b);$ei=$r.LastIndexOf($e);if($bi-lt0-or$ei-le$bi){throw 'ABM payload markers are invalid'};$s=[regex]::Replace($r.Substring($bi+$b.Length,$ei-$bi-$b.Length),'\s','');$bytes=[Convert]::FromBase64String($s);$a=[Security.Cryptography.SHA256]::Create();try{$h=([BitConverter]::ToString($a.ComputeHash($bytes))).Replace('-','').ToLowerInvariant()}finally{$a.Dispose()};if($h-ne$env:PS_ABM_SHA){throw ('ABM ZIP hash mismatch: '+$h)};[IO.File]::WriteAllBytes($env:PS_ABM_ZIP,$bytes)" >>"%ABM_LOG%" 2>&1
if errorlevel 1 exit /b 1
mkdir "%ABM_CANDIDATE%" >nul 2>&1
call :ABM_EXTRACT "%ABM_ZIP%" "%ABM_CANDIDATE%" "%ABM_CANDIDATE%\server.mjs"
if errorlevel 1 exit /b 1
if not exist "%ABM_CANDIDATE%\dist\index.html" exit /b 1
set "ABM_TEST_ROOT=%ABM_RUNTIME%\candidate-selftest"
if exist "%ABM_TEST_ROOT%" rmdir /s /q "%ABM_TEST_ROOT%" >nul 2>&1
set "ABM_SAVE_ROOT=%ABM_ROOT%"
set "ABM_SAVE_DATA=%ABM_DATA%"
set "ABM_SAVE_LOGS=%ABM_LOGS%"
set "ABM_SAVE_BACKUPS=%ABM_BACKUPS%"
set "ABM_ROOT=%ABM_TEST_ROOT%"
set "ABM_DATA=%ABM_TEST_ROOT%\data"
set "ABM_LOGS=%ABM_TEST_ROOT%\logs"
set "ABM_BACKUPS=%ABM_TEST_ROOT%\backups"
"%ABM_NODE%" --no-warnings "%ABM_CANDIDATE%\server.mjs" --selftest >>"%ABM_LOG%" 2>&1
set "ABM_TEST_RC=%ERRORLEVEL%"
set "ABM_ROOT=%ABM_SAVE_ROOT%"
set "ABM_DATA=%ABM_SAVE_DATA%"
set "ABM_LOGS=%ABM_SAVE_LOGS%"
set "ABM_BACKUPS=%ABM_SAVE_BACKUPS%"
if exist "%ABM_TEST_ROOT%" rmdir /s /q "%ABM_TEST_ROOT%" >nul 2>&1
if not "%ABM_TEST_RC%"=="0" exit /b 1
call :ABM_STOP_SERVER >nul 2>&1
set "PS_ABM_LIVE=%ABM_CURRENT%"
set "PS_ABM_CANDIDATE=%ABM_CANDIDATE%"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$l=$env:PS_ABM_LIVE;$c=$env:PS_ABM_CANDIDATE;$b=$l+'.last-good';if(Test-Path -LiteralPath $b){Remove-Item -LiteralPath $b -Recurse -Force};if(Test-Path -LiteralPath $l){[IO.Directory]::Move($l,$b)};try{[IO.Directory]::Move($c,$l)}catch{if((Test-Path -LiteralPath $b)-and-not(Test-Path -LiteralPath $l)){[IO.Directory]::Move($b,$l)};throw}" >>"%ABM_LOG%" 2>&1
if errorlevel 1 exit /b 1
call :ABM_WRITE_MANIFEST
call :ABM_WRITE_LAUNCHER
del /q "%ABM_ZIP%" >nul 2>&1
set "ABM_FORCE="
exit /b 0

:ABM_VERIFY_CURRENT
if not exist "%ABM_CURRENT%\server.mjs" exit /b 1
if not exist "%ABM_CURRENT%\launcher.mjs" exit /b 1
if not exist "%ABM_CURRENT%\dist\index.html" exit /b 1
if not exist "%ABM_MANIFEST%" exit /b 1
findstr /L /C:"AppZipSHA256=%ABM_ZIP_SHA%" "%ABM_MANIFEST%" >nul 2>&1
exit /b %ERRORLEVEL%

:ABM_FIND_NODE
set "ABM_NODE="
for %%N in ("%ABM_RUNTIME%\Node\node.exe" "%LOCALAPPDATA%\JadonUniDev\Node\node.exe" "%ProgramFiles%\nodejs\node.exe") do if not defined ABM_NODE if exist "%%~N" call :ABM_TEST_NODE "%%~N"
if defined ABM_NODE exit /b 0
for /f "delims=" %%N in ('where node.exe 2^>nul') do if not defined ABM_NODE call :ABM_TEST_NODE "%%~N"
if defined ABM_NODE exit /b 0
exit /b 1

:ABM_TEST_NODE
"%~1" --no-warnings -e "if(Number(process.versions.node.split('.')[0])<22)process.exit(2);require('node:sqlite');" >nul 2>&1
if not errorlevel 1 set "ABM_NODE=%~1"
exit /b 0

:ABM_INSTALL_NODE
echo.
echo No compatible Node runtime was found. Preparing official portable Node %ABM_NODE_VERSION%...
set "ABM_ARCH=x64"
if /I "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "ABM_ARCH=arm64"
if /I "%PROCESSOR_ARCHITEW6432%"=="ARM64" set "ABM_ARCH=arm64"
set "ABM_NODE_FOLDER=node-v%ABM_NODE_VERSION%-win-%ABM_ARCH%"
set "ABM_NODE_ZIP=%ABM_RUNTIME%\%ABM_NODE_FOLDER%.zip"
set "ABM_NODE_SUMS=%ABM_RUNTIME%\SHASUMS256.txt"
set "ABM_NODE_STAGE=%ABM_RUNTIME%\Node.candidate"
set "ABM_DL_URL=https://nodejs.org/dist/v%ABM_NODE_VERSION%/%ABM_NODE_FOLDER%.zip"
set "ABM_DL_OUT=%ABM_NODE_ZIP%"
call :ABM_DOWNLOAD
if errorlevel 1 exit /b 1
set "ABM_DL_URL=https://nodejs.org/dist/v%ABM_NODE_VERSION%/SHASUMS256.txt"
set "ABM_DL_OUT=%ABM_NODE_SUMS%"
call :ABM_DOWNLOAD
if errorlevel 1 exit /b 1
set "PS_ABM_NODE_ZIP=%ABM_NODE_ZIP%"
set "PS_ABM_NODE_SUMS=%ABM_NODE_SUMS%"
set "PS_ABM_NODE_NAME=%ABM_NODE_FOLDER%.zip"
powershell.exe -NoLogo -NoProfile -Command "$line=Get-Content -LiteralPath $env:PS_ABM_NODE_SUMS|Where-Object{$_ -match ('\s'+[regex]::Escape($env:PS_ABM_NODE_NAME)+'$')}|Select-Object -First 1;if(-not$line){exit 2};$want=($line-split '\s+')[0].ToLowerInvariant();$got=(Get-FileHash -LiteralPath $env:PS_ABM_NODE_ZIP -Algorithm SHA256).Hash.ToLowerInvariant();if($want-ne$got){exit 3}" >>"%ABM_LOG%" 2>&1
if errorlevel 1 exit /b 1
if exist "%ABM_NODE_STAGE%" rmdir /s /q "%ABM_NODE_STAGE%" >nul 2>&1
mkdir "%ABM_NODE_STAGE%" >nul 2>&1
call :ABM_EXTRACT "%ABM_NODE_ZIP%" "%ABM_NODE_STAGE%" "%ABM_NODE_STAGE%\%ABM_NODE_FOLDER%\node.exe"
if errorlevel 1 exit /b 1
set "ABM_NODE_CANDIDATE=%ABM_NODE_STAGE%\%ABM_NODE_FOLDER%\node.exe"
call :ABM_TEST_NODE "%ABM_NODE_CANDIDATE%"
if not defined ABM_NODE exit /b 1
set "PS_ABM_NODE_SOURCE=%ABM_NODE_STAGE%\%ABM_NODE_FOLDER%"
set "PS_ABM_NODE_LIVE=%ABM_RUNTIME%\Node"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$s=$env:PS_ABM_NODE_SOURCE;$l=$env:PS_ABM_NODE_LIVE;$b=$l+'.last-good';if(Test-Path -LiteralPath $b){Remove-Item -LiteralPath $b -Recurse -Force};if(Test-Path -LiteralPath $l){[IO.Directory]::Move($l,$b)};try{[IO.Directory]::Move($s,$l)}catch{if((Test-Path -LiteralPath $b)-and-not(Test-Path -LiteralPath $l)){[IO.Directory]::Move($b,$l)};throw}" >>"%ABM_LOG%" 2>&1
if errorlevel 1 exit /b 1
set "ABM_NODE=%ABM_RUNTIME%\Node\node.exe"
"%ABM_NODE%" --no-warnings -e "require('node:sqlite');console.log(process.version)" >>"%ABM_LOG%" 2>&1
exit /b %ERRORLEVEL%

:ABM_DOWNLOAD
if exist "%ABM_DL_OUT%" del /q "%ABM_DL_OUT%" >nul 2>&1
where curl.exe >nul 2>&1
if errorlevel 1 goto :ABM_DOWNLOAD_PS
curl.exe -L --fail --retry 3 --retry-delay 2 --connect-timeout 25 --progress-bar -o "%ABM_DL_OUT%" "%ABM_DL_URL%"
if not errorlevel 1 if exist "%ABM_DL_OUT%" exit /b 0
:ABM_DOWNLOAD_PS
powershell.exe -NoLogo -NoProfile -Command "try{[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;Invoke-WebRequest -UseBasicParsing -Uri $env:ABM_DL_URL -OutFile $env:ABM_DL_OUT;exit 0}catch{exit 1}" >>"%ABM_LOG%" 2>&1
if not errorlevel 1 if exist "%ABM_DL_OUT%" exit /b 0
where certutil.exe >nul 2>&1
if errorlevel 1 exit /b 1
certutil.exe -urlcache -split -f "%ABM_DL_URL%" "%ABM_DL_OUT%" >>"%ABM_LOG%" 2>&1
if not errorlevel 1 if exist "%ABM_DL_OUT%" exit /b 0
exit /b 1

:ABM_EXTRACT
set "ABM_EX_ZIP=%~1"
set "ABM_EX_DIR=%~2"
set "ABM_EX_EXPECT=%~3"
where tar.exe >nul 2>&1
if errorlevel 1 goto :ABM_EXTRACT_DOTNET
tar.exe -xf "%ABM_EX_ZIP%" -C "%ABM_EX_DIR%" >>"%ABM_LOG%" 2>&1
if not errorlevel 1 if exist "%ABM_EX_EXPECT%" exit /b 0
:ABM_EXTRACT_DOTNET
set "PS_ABM_EX_ZIP=%ABM_EX_ZIP%"
set "PS_ABM_EX_DIR=%ABM_EX_DIR%"
powershell.exe -NoLogo -NoProfile -Command "try{Add-Type -AssemblyName System.IO.Compression.FileSystem;[IO.Compression.ZipFile]::ExtractToDirectory($env:PS_ABM_EX_ZIP,$env:PS_ABM_EX_DIR);exit 0}catch{exit 1}" >>"%ABM_LOG%" 2>&1
if not errorlevel 1 if exist "%ABM_EX_EXPECT%" exit /b 0
where cscript.exe >nul 2>&1
if errorlevel 1 exit /b 1
set "ABM_VBS=%ABM_RUNTIME%\extract-abm-zip.vbs"
>"%ABM_VBS%" echo Set fso = CreateObject("Scripting.FileSystemObject")
>>"%ABM_VBS%" echo Set sh = CreateObject("Shell.Application")
>>"%ABM_VBS%" echo Set zs = sh.NameSpace(WScript.Arguments(0))
>>"%ABM_VBS%" echo Set ds = sh.NameSpace(WScript.Arguments(1))
>>"%ABM_VBS%" echo If zs Is Nothing Or ds Is Nothing Then WScript.Quit 1
>>"%ABM_VBS%" echo ds.CopyHere zs.Items, 20
>>"%ABM_VBS%" echo For i = 1 To 120
>>"%ABM_VBS%" echo   If fso.FileExists(WScript.Arguments(2)) Then WScript.Quit 0
>>"%ABM_VBS%" echo   WScript.Sleep 500
>>"%ABM_VBS%" echo Next
>>"%ABM_VBS%" echo WScript.Quit 1
cscript.exe //nologo "%ABM_VBS%" "%ABM_EX_ZIP%" "%ABM_EX_DIR%" "%ABM_EX_EXPECT%" >>"%ABM_LOG%" 2>&1
if not errorlevel 1 if exist "%ABM_EX_EXPECT%" exit /b 0
exit /b 1

:ABM_WRITE_MANIFEST
>"%ABM_MANIFEST%" echo Product=Jadon's Ultimate Installer
>>"%ABM_MANIFEST%" echo Module=A Betting Man
>>"%ABM_MANIFEST%" echo Version=%ABM_VERSION%
>>"%ABM_MANIFEST%" echo AppZipSHA256=%ABM_ZIP_SHA%
>>"%ABM_MANIFEST%" echo Program=%ABM_CURRENT%
>>"%ABM_MANIFEST%" echo Runtime=%ABM_NODE%
>>"%ABM_MANIFEST%" echo Data=%ABM_DATA%
>>"%ABM_MANIFEST%" echo Installed=%DATE% %TIME%
>"%ABM_LOCATION%" echo A Betting Man version: %ABM_VERSION%
>>"%ABM_LOCATION%" echo Program: %ABM_CURRENT%
>>"%ABM_LOCATION%" echo Data: %ABM_DATA%
>>"%ABM_LOCATION%" echo Launcher: %ABM_LAUNCHER%
exit /b 0

:ABM_WRITE_LAUNCHER
>"%ABM_LAUNCHER%" echo @echo off
>>"%ABM_LAUNCHER%" echo setlocal EnableExtensions DisableDelayedExpansion
>>"%ABM_LAUNCHER%" echo title A Betting Man Launcher
>>"%ABM_LAUNCHER%" echo set "ABM_ROOT=%ABM_ROOT%"
>>"%ABM_LAUNCHER%" echo set "ABM_RUNTIME=%ABM_RUNTIME%"
>>"%ABM_LAUNCHER%" echo set "ABM_DATA=%ABM_DATA%"
>>"%ABM_LAUNCHER%" echo set "ABM_LOGS=%ABM_LOGS%"
>>"%ABM_LAUNCHER%" echo set "ABM_BACKUPS=%ABM_BACKUPS%"
>>"%ABM_LAUNCHER%" echo set "ABM_FORGE_BASE=%ABM_FORGE_BASE%"
>>"%ABM_LAUNCHER%" echo "%ABM_NODE%" --no-warnings "%ABM_CURRENT%\launcher.mjs" --page=%%~1
>>"%ABM_LAUNCHER%" echo if errorlevel 1 ^(
>>"%ABM_LAUNCHER%" echo   echo.
>>"%ABM_LAUNCHER%" echo   echo A Betting Man could not open. Review: %ABM_LOGS%
>>"%ABM_LAUNCHER%" echo   pause
>>"%ABM_LAUNCHER%" echo ^)
>>"%ABM_LAUNCHER%" echo endlocal
exit /b 0

:ABM_OPEN_PAGE
call :ABM_PREPARE_APP
if errorlevel 1 (
  echo Application validation failed. The last-good copy was retained.
  pause
  exit /b 1
)
call "%ABM_LAUNCHER%" "%~1"
echo.
echo The requested A Betting Man screen was sent to your browser.
echo This manager remains open. Return here whenever you are finished.
pause
exit /b 0

:ABM_REPAIR
set "ABM_FORCE=1"
call :ABM_PREPARE_APP
if errorlevel 1 echo Repair candidate failed. The previous working copy and campaign data were retained.
if not errorlevel 1 echo Repair completed and the validated candidate was promoted.
pause
goto :ABM_MENU_ONE

:ABM_HOST_CONSOLE
call :ABM_PREPARE_APP
if errorlevel 1 exit /b 1
call :ABM_STOP_SERVER >nul 2>&1
"%ABM_NODE%" --no-warnings "%ABM_CURRENT%\server.mjs" --console
pause
exit /b 0

:ABM_DIAGNOSTICS
call :ABM_VERIFY_CURRENT
set "ABM_DIAG_CURRENT=%ERRORLEVEL%"
call :ABM_FIND_NODE
set "ABM_DIAG_NODE=%ERRORLEVEL%"
echo.
if "%ABM_DIAG_CURRENT%"=="0" echo [PASS] Program manifest and required application files
if not "%ABM_DIAG_CURRENT%"=="0" echo [FAIL] Program manifest or application files
if "%ABM_DIAG_NODE%"=="0" echo [PASS] Node 22+ and built-in SQLite
if not "%ABM_DIAG_NODE%"=="0" echo [FAIL] Node 22+ and built-in SQLite
if exist "%ABM_FORGE_BASE%\Forge_Location.txt" echo [PASS] Managed Forge location file
if not exist "%ABM_FORGE_BASE%\Forge_Location.txt" echo [WARN] Forge is not installed; manual setup remains available
if defined ABM_NODE if exist "%ABM_CURRENT%\server.mjs" "%ABM_NODE%" --no-warnings "%ABM_CURRENT%\server.mjs" --selftest
echo.
echo Diagnostics log: %ABM_LOG%
pause
exit /b 0

:ABM_OPEN_FOLDERS
for %%D in ("%ABM_DATA%" "%ABM_BACKUPS%" "%ABM_LOGS%" "%ABM_CURRENT%\docs") do if exist "%%~D" start "" "%%~D"
exit /b 0

:ABM_BACKUP
call :ABM_PREPARE_APP
if errorlevel 1 exit /b 1
call :ABM_STOP_SERVER >nul 2>&1
"%ABM_NODE%" --no-warnings "%ABM_CURRENT%\server.mjs" --backup
pause
exit /b %ERRORLEVEL%

:ABM_RESTORE
call :ABM_PREPARE_APP
if errorlevel 1 exit /b 1
echo.
echo Restore never touches Forge decks or program assets.
set "ABM_RESTORE_FILE="
set /p "ABM_RESTORE_FILE=Paste the full path of the .sqlite backup: "
if not defined ABM_RESTORE_FILE exit /b 0
if not exist "%ABM_RESTORE_FILE%" (
  echo The selected file does not exist.
  pause
  exit /b 1
)
set "ABM_CONFIRM_NAME="
set /p "ABM_CONFIRM_NAME=Type the exact campaign name contained in that backup: "
if not defined ABM_CONFIRM_NAME exit /b 0
call :ABM_STOP_SERVER >nul 2>&1
"%ABM_NODE%" --no-warnings "%ABM_CURRENT%\server.mjs" --restore "%ABM_RESTORE_FILE%" "%ABM_CONFIRM_NAME%"
if errorlevel 1 echo Restore failed safely. The live database or pre-restore backup was retained.
pause
exit /b %ERRORLEVEL%

:ABM_STOP_SERVER
if not exist "%ABM_RUNTIME%\server-control.json" exit /b 0
set "PS_ABM_CONTROL=%ABM_RUNTIME%\server-control.json"
powershell.exe -NoLogo -NoProfile -Command "try{$c=Get-Content -LiteralPath $env:PS_ABM_CONTROL -Raw|ConvertFrom-Json;$h=@{'X-ABM-Token'=[string]$c.token};Invoke-WebRequest -UseBasicParsing -Method Post -Uri ('http://127.0.0.1:'+$c.port+'/api/shutdown') -Headers $h -ContentType 'application/json' -Body '{}'|Out-Null;exit 0}catch{exit 1}" >nul 2>&1
if errorlevel 1 echo The service was not reachable. A stale control file may remain.
if not errorlevel 1 echo Local campaign service stopped cleanly.
exit /b 0

:ABM_SHOW_MANIFEST
echo.
if exist "%ABM_MANIFEST%" type "%ABM_MANIFEST%"
if not exist "%ABM_MANIFEST%" echo No promoted version manifest is available.
echo.
pause
exit /b 0

:ABM_SELFTEST
set "ABM_TEST_ZIP=%TEMP%\abm-payload-selftest-%RANDOM%.zip"
set "PS_ABM_SELF=%ABM_SELF%"
set "PS_ABM_ZIP=%ABM_TEST_ZIP%"
set "PS_ABM_SHA=%ABM_ZIP_SHA%"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$r=[IO.File]::ReadAllText($env:PS_ABM_SELF);$b='###JADON_ABM_APP_ZIP_BEGIN###';$e='###JADON_ABM_APP_ZIP_END###';$bi=$r.LastIndexOf($b);$ei=$r.LastIndexOf($e);if($bi-lt0-or$ei-le$bi){throw 'markers'};$bytes=[Convert]::FromBase64String([regex]::Replace($r.Substring($bi+$b.Length,$ei-$bi-$b.Length),'\s',''));$a=[Security.Cryptography.SHA256]::Create();try{$h=([BitConverter]::ToString($a.ComputeHash($bytes))).Replace('-','').ToLowerInvariant()}finally{$a.Dispose()};if($h-ne$env:PS_ABM_SHA){throw 'hash'};[IO.File]::WriteAllBytes($env:PS_ABM_ZIP,$bytes);Add-Type -AssemblyName System.IO.Compression.FileSystem;$z=[IO.Compression.ZipFile]::OpenRead($env:PS_ABM_ZIP);try{$names=@($z.Entries.FullName|ForEach-Object{$_.Replace('\','/')});if($names-notcontains'server.mjs'-or$names-notcontains'launcher.mjs'-or$names-notcontains'dist/index.html'-or$names-notcontains'asset-manifest.json'){throw 'entries'}}finally{$z.Dispose()}" >nul 2>&1
set "ABM_TEST_RC=%ERRORLEVEL%"
if exist "%ABM_TEST_ZIP%" del /q "%ABM_TEST_ZIP%" >nul 2>&1
if not "%ABM_TEST_RC%"=="0" exit /b 1
echo A Betting Man embedded ZIP markers, SHA-256, and required entries: PASS
exit /b 0

:ABM_INSTALL_TEST
call :ABM_INIT
if errorlevel 1 exit /b 1
set "ABM_FORCE=1"
call :ABM_PREPARE_APP
if errorlevel 1 exit /b 1
call :ABM_VERIFY_CURRENT
if errorlevel 1 exit /b 1
echo A Betting Man candidate extraction, runtime self-test, promotion, manifest, and launcher: PASS
exit /b 0

:ABM_FATAL
echo.
echo A Betting Man could not initialize its current-user folders.
echo No Forge, importer, UniDev, Riftfront, or campaign file was removed.
pause
exit /b 1

:ABM_END
endlocal
exit /b 0

