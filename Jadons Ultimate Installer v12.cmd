  exit /b 1
)
call :UD_BAR "PRODUCTION BUILD" "##################################......" 85
call "%NPM_CMD%" run build
if errorlevel 1 (
  popd
  echo   [FAIL] Riftfront source did not pass the Vite production build.
  exit /b 1
)
popd
call :UD_BAR "RIFTFRONT READY" "########################################" 100
echo   [PASS] New game: %GAME_DIR%
