"%PY_EXE%" -c "import seaborn,plotly,statsmodels,xlsxwriter,bs4,lxml,PIL,sympy,sqlalchemy,tqdm,jupyterlab,polars,pyarrow,duckdb;print('Full Python package suite test: PASS')"
