        Write-Host ("[3]  Similarity detection               [" + (Get-OnOff ([bool]$Settings.SimilarityDetection)) + "]")
        Write-Host ("[4]  Similarity threshold               [" + [string]$Settings.SimilarityThreshold + "%]")
        Write-Host ""
