  const response=await fetch('/status',{cache:'no-store',signal:controller.signal});if(!response.ok)throw new Error(`Status HTTP ${response.status}`);
  const status=await response.json();if(status.status!=='ready')throw new Error('Unexpected service status');
  const signature=`${status.session}/${status.bytes}/${status.modifiedAt}`;
  // File metadata avoids downloading and reparsing megabytes when a match is idle.
  if(signature!==S.signature){const feed=await fetch('/telemetry',{cache:'no-store',signal:controller.signal});if(!feed.ok)throw new Error(`Feed HTTP ${feed.status}`);const events=parse(await feed.text());if(generation!==S.generation)return;S.events=events;S.signature=signature;S.lastCount=events.length;render()}
  if(generation!==S.generation)return;
