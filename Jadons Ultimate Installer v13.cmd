 if(location.protocol==='file:'){S.source='offline';$('sourceTitle').textContent='SAVED VIEWER / NOT CONNECTED';$('sourceDetail').textContent='Launch AI Viewer from the installer. Its browser tab connects to the running service; opening this HTML file directly cannot receive a live feed. You can still inspect a saved session log.';return}
