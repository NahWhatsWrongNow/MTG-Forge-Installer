function Write-AiTelemetryServerJava {
    param([string]$Path)

    $java = @'
package forge.ai.simulation;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;
import java.awt.Desktop;
import java.io.IOException;
import java.net.InetAddress;
import java.net.InetSocketAddress;
import java.net.URI;
import java.nio.ByteBuffer;
import java.nio.channels.FileChannel;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardOpenOption;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.Executors;

public final class AiTelemetryServer {
    private static final int FIRST_PORT = 5186;
    private static final int MAX_TELEMETRY_BYTES = 4 * 1024 * 1024;
    private static final long STARTED = System.currentTimeMillis();
    private static volatile boolean recording = true;

    private AiTelemetryServer() {
    }

    private static byte[] tail(Path path) throws IOException {
        if (!Files.isRegularFile(path)) return new byte[0];
        try (FileChannel channel = FileChannel.open(path, StandardOpenOption.READ)) {
            long size = channel.size();
            int count = (int)Math.min(size, MAX_TELEMETRY_BYTES);
            long start = size - count;
            ByteBuffer buffer = ByteBuffer.allocate(count);
            channel.position(start);
            while (buffer.hasRemaining() && channel.read(buffer) >= 0) { }
            byte[] bytes = buffer.array();
            if (start == 0) return bytes;
            int newline = 0;
            while (newline < bytes.length && bytes[newline] != '\n') newline++;
            if (newline >= bytes.length - 1) return new byte[0];
            byte[] complete = new byte[bytes.length - newline - 1];
            System.arraycopy(bytes, newline + 1, complete, 0, complete.length);
            return complete;
        }
    }

    private static void send(HttpExchange exchange, int status, String contentType, byte[] body) throws IOException {
        exchange.getResponseHeaders().set("Content-Type", contentType);
        exchange.getResponseHeaders().set("Cache-Control", "no-store, max-age=0");
        exchange.getResponseHeaders().set("X-Content-Type-Options", "nosniff");
        exchange.sendResponseHeaders(status, body.length);
        try (var output = exchange.getResponseBody()) { output.write(body); }
    }

    private static void openBrowser(URI uri) {
        try {
            if (Desktop.isDesktopSupported()) {
                Desktop.getDesktop().browse(uri);
                return;
            }
        } catch (Throwable ignored) { }
        try {
            new ProcessBuilder("rundll32.exe", "url.dll,FileProtocolHandler", uri.toString()).start();
        } catch (Throwable ignored) { }
    }

    private static HttpServer startServer(Path viewer, Path telemetry, int port) throws IOException {
        HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getByName("127.0.0.1"), port), 0);
        server.createContext("/", exchange -> {
            try {
                if (!"GET".equals(exchange.getRequestMethod())) { send(exchange, 405, "text/plain", new byte[0]); return; }
                String path = exchange.getRequestURI().getPath();
                if ("/telemetry".equals(path)) {
                    send(exchange, 200, "application/x-ndjson; charset=utf-8", tail(telemetry));
                } else if ("/health".equals(path) || "/status".equals(path)) {
                    boolean exists = Files.isRegularFile(telemetry);
                    long bytes = exists ? Files.size(telemetry) : 0;
                    long modified = exists ? Files.getLastModifiedTime(telemetry).toMillis() : 0;
                    String status = "{\"status\":\"ready\",\"revision\":5,\"uptimeMs\":" + (System.currentTimeMillis()-STARTED)
                        + ",\"session\":" + STARTED + ",\"recording\":" + recording + ",\"bytes\":" + bytes + ",\"modifiedAt\":" + modified + ",\"serverTime\":" + System.currentTimeMillis() + "}";
                    send(exchange, 200, "application/json; charset=utf-8", status.getBytes(StandardCharsets.UTF_8));
                } else if ("/".equals(path) || "/index.html".equals(path)) {
                    send(exchange, Files.isRegularFile(viewer) ? 200 : 404, "text/html; charset=utf-8", Files.isRegularFile(viewer) ? Files.readAllBytes(viewer) : "Viewer missing".getBytes(StandardCharsets.UTF_8));
                } else {
                    send(exchange, 404, "text/plain; charset=utf-8", "Not found".getBytes(StandardCharsets.UTF_8));
                }
            } catch (Throwable error) {
                try { send(exchange, 500, "text/plain; charset=utf-8", "Telemetry read failed".getBytes(StandardCharsets.UTF_8)); } catch (Throwable ignored) { }
            }
        });
        server.setExecutor(Executors.newFixedThreadPool(2, runnable -> {
            Thread thread = new Thread(runnable, "forge-ai-viewer-http");
            thread.setDaemon(true);
            thread.setPriority(Thread.MIN_PRIORITY);
            return thread;
        }));
        server.start();
        return server;
    }

    public static void main(String[] args) {
        Path viewer = Paths.get(System.getProperty("jadon.ai.viewer", ""));
        Path telemetry = Paths.get(System.getProperty("jadon.ai.telemetry", ""));
        boolean viewerOnly = args.length > 0 && ("--viewer-only".equals(args[0]) || "--no-browser".equals(args[0]));
        recording = !viewerOnly;
        HttpServer server = null;
        int selectedPort = 0;
        for (int port = FIRST_PORT; port < FIRST_PORT + 10 && server == null; port++) {
            try {
                server = startServer(viewer, telemetry, port);
                selectedPort = port;
            } catch (Throwable ignored) { }
        }
        if (server == null) {
            System.err.println("Dashboard unavailable: localhost ports 5186-5195 are busy or blocked. Forge can continue; recorded session logs remain available.");
            if (!viewerOnly) {
                try { Class.forName("forge.view.Main").getMethod("main", String[].class).invoke(null, (Object)new String[0]); }
                catch (Throwable error) { error.printStackTrace(); System.exit(2); }
            }
            return;
        }
        URI uri = URI.create("http://127.0.0.1:" + selectedPort + "/");
        final HttpServer runningServer = server;
        Runtime.getRuntime().addShutdownHook(new Thread(() -> runningServer.stop(0), "forge-ai-viewer-shutdown"));
        System.out.println("AI dashboard: " + uri + " | waiting for recorded AI decisions");
        boolean noBrowser = Boolean.getBoolean("jadon.ai.noBrowser") || (args.length > 0 && "--no-browser".equals(args[0]));
        if (!noBrowser) openBrowser(uri);
        try {
            if (viewerOnly) {
                new CountDownLatch(1).await();
            } else {
                Class<?> mainClass = Class.forName("forge.view.Main");
                mainClass.getMethod("main", String[].class).invoke(null, (Object)new String[0]);
                // Swing main returns after scheduling the window. Keep the service alive
                // until Forge exits; never tie HTTP lifetime to main() returning.
                new CountDownLatch(1).await();
            }
        } catch (InterruptedException ignored) {
            Thread.currentThread().interrupt();
        } catch (Throwable error) {
            error.printStackTrace();
            System.exit(2);
        }
    }
}
'@

    $encoding = New-Object System.Text.UTF8Encoding($false)
    [IO.File]::WriteAllText($Path, $java, $encoding)
}

