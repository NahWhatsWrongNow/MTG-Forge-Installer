  $('sourceDetail').textContent=!status.recording?'No telemetry-enabled Forge session was found. In the installer AI Viewer menu choose [2] Run Forge with live statistics. Its new browser tab will connect automatically. Saved logs can be inspected here.':S.events.length?`${S.events.length} events in recent log window | latest write ${age}s ago | service healthy`:'Service healthy. Start a match with a computer player in this telemetry-enabled Forge window.';
 }catch(error){
