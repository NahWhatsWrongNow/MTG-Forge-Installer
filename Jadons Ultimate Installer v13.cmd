 const names=[...new Set(S.events.map(e=>e.player).filter(Boolean))].sort(),selector=$('pilotFilter'),signature=names.join('\n');if(selector.dataset.signature!==signature){const selected=selector.value;selector.replaceChildren(new Option('All AI pilots','all'),...names.map(name=>new Option(name,name)));selector.value=names.includes(selected)?selected:'all';selector.dataset.signature=signature}const ev=selector.value==='all'?S.events:S.events.filter(e=>e.player===selector.value),last=[...ev].reverse().find(e=>e.player),choices=ev.filter(e=>['planned','heuristic_chosen','simulation_best'].includes(e.type))
 $('pilot').textContent=last?.player||'Computer AI';$('decisions').textContent=ev.filter(e=>['decision_start','heuristic_start'].includes(e.type)).length||choices.length
 $('candidates').textContent=ev.filter(e=>['candidate','heuristic_candidate','evaluated'].includes(e.type)).length
 $('simulations').textContent=ev.reduce((n,e)=>n+(+e.simulations||0),0);const timed=[...ev].reverse().find(e=>e.milliseconds!=null);$('latency').textContent=timed?`${timed.milliseconds} ms`:'-'
 const snapshot=[...ev].reverse().find(e=>['decision_start','heuristic_start'].includes(e.type));$('mode').textContent=snapshot?.mode||(ev.length?(ev.some(e=>e.type==='evaluated')?'SIM':'HEURISTIC'):'WAITING');$('life').textContent=snapshot?.life??'-';$('hand').textContent=snapshot?.hand??'-';$('board').textContent=snapshot?.battlefield??'-';$('mana').textContent=snapshot?.mana??'-'
 const insights=ev.map(thought).filter(Boolean).slice(-80).reverse();$('thoughts').innerHTML=insights.length?insights.map((t,i)=>`<div class="thought ${t[2]}"><time>#${insights.length-i}</time><b>${esc(t[0])}</b><span>${esc(t[1])}</span></div>`).join(''):'<div class="empty"><div><b>Live feed ready</b>Start a match; decisions will appear automatically.</div></div>'
 const rows=ev.filter(e=>['candidate','heuristic_candidate','evaluated','simulation_best','plan','planned','heuristic_chosen','combat_attack','combat_block'].includes(e.type)).slice(-250).reverse()
 $('rows').innerHTML=rows.length?rows.map(e=>`<tr class="${['planned','heuristic_chosen','simulation_best'].includes(e.type)?'chosen':''}"><td>${esc(`${e.turn??'-'} / ${e.phase??'-'}`)}</td><td><span class="pill">${esc(e.type)}</span></td><td>${esc(e.action||e.plan||e.combat||'-')}</td><td>${esc(e.status||e.decision||'-')}</td><td>${esc(e.available??e.score??'-')}</td></tr>`).join(''):'<tr><td colspan="5">Waiting for telemetry events...</td></tr>'
 drawChart(ev);drawNetwork(ev)
}
function drawChart(ev){
 const c=$('chart'),dpr=devicePixelRatio||1,r=c.getBoundingClientRect();c.width=Math.max(400,r.width*dpr);c.height=Math.max(220,r.height*dpr);const x=c.getContext('2d');x.scale(dpr,dpr);const w=r.width,h=r.height;x.clearRect(0,0,w,h)
