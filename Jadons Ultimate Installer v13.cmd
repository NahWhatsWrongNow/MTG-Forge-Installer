:UD_DOWNLOAD_NODE
set "NARCH=x64"
if /I "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "NARCH=arm64"
if /I "%PROCESSOR_ARCHITEW6432%"=="AMD64" set "NARCH=x64"
if /I "%PROCESSOR_ARCHITECTURE%"=="x86" (
  echo   32-bit Windows cannot run the supported Node 24 toolchain.
