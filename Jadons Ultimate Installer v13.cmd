$('demo').onclick=()=>{stopPolling();S.source='demo';S.events=demoEvents();$('dot').classList.remove('live');$('sourceTitle').textContent='SAMPLE DATA / NOT A LIVE MATCH';$('sourceDetail').textContent='Demonstration only. Reconnect for recorded game events.';render()}
$('clear').onclick=()=>{stopPolling();S.source='paused';$('dot').classList.remove('live');$('sourceTitle').textContent='LIVE FEED PAUSED';$('sourceDetail').textContent='The game and recorder continue; reconnect whenever you want.';render()};addEventListener('resize',()=>{drawChart(S.events);drawNetwork(S.events)});window.render_dashboard_to_text=()=>JSON.stringify({source:S.source,events:S.events.length,thoughts:S.events.map(thought).filter(Boolean).length,automatic:S.source==='automatic',failures:S.failures,status:S.status,networkStages:6});render();connectAutomatic()
