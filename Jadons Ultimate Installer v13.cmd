                Write-Host ""

                if ($Settings.RemoveActualTokens) {
                    Write-Host "Only cards whose actual metadata identifies them as a Token or Emblem"
                    Write-Host "will be excluded. Categories such as [Tokens] are ignored for removal."
                }
