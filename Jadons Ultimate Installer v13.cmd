function Run-Radar {
 $task=$env:I12_TASK
 if($task-notin@('CORE','SAFE','LEGACY','MANAGER','DEV','BETTING','ABMAPP')){throw 'Unknown preparation task.'}
 $labels=@{CORE='Forge installer and launch tools';SAFE='Archidekt profile importer';LEGACY='Compatibility installer';MANAGER='Forge Manager and AI Viewer';DEV='University Development Centre';BETTING='A Betting Man';ABMAPP='A Betting Man application and runtime'}
 $si=New-Object Diagnostics.ProcessStartInfo
 $si.FileName=$env:ComSpec
 $si.Arguments='/d /s /c ""'+$env:I7_SELF+'" --v13-prepare '+$task+'"'
 if($task-eq'ABMAPP'){$si.Arguments='/d /s /c ""'+$env:ABM_SELF+'" --prepare-only"'}
 $si.UseShellExecute=$false;$si.CreateNoWindow=$true;$si.WindowStyle='Hidden';$si.RedirectStandardOutput=$true;$si.RedirectStandardError=$true
 $p=New-Object Diagnostics.Process;$p.StartInfo=$si
 if(-not$p.Start()){throw 'Preparation process did not start.'}
 $stdout=$p.StandardOutput.ReadToEndAsync();$stderr=$p.StandardError.ReadToEndAsync();$watch=[Diagnostics.Stopwatch]::StartNew()
 try{
  Clear-Surface;Line '';Line ('      PREPARING / '+$labels[$task].ToUpper()) $accent
  Line '      Checking the embedded module. Your saved data stays in place.' Gray
  $row=4;$frame=0
  while(-not$p.HasExited){
   if($interactive-and$env:JADON_NO_ANIMATION-ne'1'){
    try{
     [Console]::SetCursorPosition(0,$row)
     $angle=($frame%72)/72*2*[Math]::PI
     for($y=-4;$y-le4;$y++){
      [Console]::Write('          ')
      for($x=-10;$x-le10;$x++){
       $radius=[Math]::Sqrt(($x/2.5)*($x/2.5)+$y*$y);$delta=([Math]::Atan2($y,$x/2.5)-$angle+4*[Math]::PI)%(2*[Math]::PI)
       $ch=' ';$color='DarkGray'
       if($radius-le4.25){$ch='.';if($radius-gt3.65){$ch='o'};if($delta-lt.5){$ch='#';$color=$accent};if($x-eq0-and$y-eq0){$ch='+';$color='White'}}
       [Console]::ForegroundColor=[ConsoleColor]$color;[Console]::Write($ch)
      };[Console]::WriteLine('                         ')
     }
     Line ('      '+(' '*($frame%24))+'>>'+(' '*(24-$frame%24))) $accent
     Line ('      VERIFYING  /  '+[Math]::Floor($watch.Elapsed.TotalSeconds)+'s elapsed                       ') $secondary
     Line (' '*72) DarkGray
    }catch{$interactive=$false}
   }
   Start-Sleep -Milliseconds 70;$frame++
  }
  $p.WaitForExit();$output=$stdout.Result+"`r`n"+$stderr.Result
  $log=Join-Path $env:I7_LOG_DIR ('v13-prepare-'+$task.ToLower()+'.log');[IO.File]::WriteAllText($log,$output)
  $result=$p.ExitCode
  if($interactive){[Console]::SetCursorPosition(0,17)}
  if($result-eq0){Line ('      READY / '+$labels[$task]) $accent}else{Line ('      PREPARATION FAILED / '+$labels[$task]) Red;Line ('      Details: '+$log) Yellow;Line $output Gray}
  exit $result
 }finally{if(-not$p.HasExited){$p.Kill()};$p.Dispose()}
}
$wasVisible=$true
try{
 if($interactive){$wasVisible=[Console]::CursorVisible;[Console]::CursorVisible=$false}
 switch($mode){welcome{Paint-Welcome} menu{Paint-Menu} radar{Run-Radar} default{throw 'Unknown console presentation mode.'}}
}finally{if($interactive){[Console]::CursorVisible=$wasVisible;[Console]::ForegroundColor='Gray'}}
