if errorlevel 1 exit /b 1
set "PS_SELF=%SELF_FILE%"
set "PS_SAFE_OUT=%DIRECT_SAFE_CMD%"
set "PS_SAFE_TMP=%DIRECT_SAFE_TMP%"
set "PS_SAFE_SHA=%EXPECTED_SAFE_SHA%"
