function Get-AiIntegrationRecord {
    $recordPath = Join-Path $AiDir 'integration.json'
    if (-not (Test-Path -LiteralPath $recordPath)) { return $null }
    $record = Get-Content -LiteralPath $recordPath -Raw | ConvertFrom-Json
    $allowed = [IO.Path]::GetFullPath((Join-Path $AiDir 'integration')).TrimEnd('\') + '\'
    if ([IO.Path]::GetFullPath([string]$record.Target) -ne [IO.Path]::GetFullPath($ForgeLauncher) -or
        -not ([IO.Path]::GetFullPath([string]$record.Backup)).StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase)) {
        throw 'The Forge launcher patch record has invalid target paths.'
    }
    return $record
}

function Enable-AiForgeIntegration {
    $status = Assert-AiViewerReady
    if (-not (Test-Path -LiteralPath $ForgeLauncher -PathType Leaf)) { throw 'Install Forge before applying the AI launcher patch.' }
    $record = Get-AiIntegrationRecord
    $currentHash = Get-FileSha256 $ForgeLauncher
    if ($record) {
        if (-not (Test-Path -LiteralPath $record.Backup) -or (Get-FileSha256 $record.Backup) -ne $record.OriginalHash) { throw 'Original launcher backup is missing or changed. Patch cancelled.' }
        if ($currentHash -eq $record.PatchedHash) { Write-Host 'AI Viewer integration is already enabled.' -ForegroundColor Green; return }
        if ($currentHash -ne $record.OriginalHash) { throw 'Forge launcher changed outside this patch. Restore or review that launcher before reapplying integration; it has not been overwritten.' }
        $backup = [string]$record.Backup
    } else {
        $folder = Join-Path (Join-Path $AiDir 'integration') ([guid]::NewGuid().ToString('N'))
        [void](New-Item -ItemType Directory -Path $folder)
        $backup = Join-Path $folder 'Start_Forge.original.cmd'
        Copy-Item -LiteralPath $ForgeLauncher -Destination $backup
    }
    if ((Get-FileSha256 $backup) -ne $currentHash) { throw 'Original launcher backup verification failed.' }
    $relativeBackup = $backup.Substring([IO.Path]::GetFullPath($Base).TrimEnd('\').Length + 1)
    $lines = @(
        '@echo off', 'setlocal EnableExtensions DisableDelayedExpansion',
        'rem JADON_AI_INTEGRATION_V14',
        'set "JADON_AI_STATUS=%~dp0AIViewer\status.json"',
        'if not exist "%JADON_AI_STATUS%" goto :NORMAL_FORGE',
        '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "$ErrorActionPreference=''Stop'';try{$s=Get-Content -LiteralPath $env:JADON_AI_STATUS -Raw|ConvertFrom-Json;foreach($k in @(''ForgeJar'',''PatchJar'',''ViewerScript'',''Launcher'')){$p=[string]$s.$k;$h=[string]$s.($k+''Hash'');if(-not(Test-Path -LiteralPath $p)-or[string]::IsNullOrWhiteSpace($h)-or(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash-ne$h){exit 1}};exit 0}catch{exit 1}" >nul 2>&1',
        'if errorlevel 1 goto :NORMAL_FORGE',
        'call "%~dp0AIViewer\Start_Forge_AI_Viewer.cmd" %*',
        'exit /b %ERRORLEVEL%', ':NORMAL_FORGE',
        'echo AI Viewer needs repair. Starting the original Forge launcher.',
        ('call "%~dp0' + $relativeBackup + '" %*'),
        'exit /b %ERRORLEVEL%'
    )
    $candidate = Join-Path $AiDir ('launcher-patch-' + [guid]::NewGuid().ToString('N') + '.cmd')
    [IO.File]::WriteAllLines($candidate, $lines, (New-Object Text.ASCIIEncoding))
    $record = [ordered]@{Version=1;Target=$ForgeLauncher;Backup=$backup;OriginalHash=$currentHash;PatchedHash=(Get-FileSha256 $candidate);CreatedAt=(Get-Date).ToString('o')}
    $recordPath = Join-Path $AiDir 'integration.json'
    $recordCandidate = $recordPath + '.candidate'
    [IO.File]::WriteAllText($recordCandidate, ($record|ConvertTo-Json), (New-Object Text.UTF8Encoding($false)))
    try {
        # Persist recovery metadata before replacing the entry point.
        if (Test-Path -LiteralPath $recordPath) { [IO.File]::Replace($recordCandidate,$recordPath,[NullString]::Value) } else { [IO.File]::Move($recordCandidate,$recordPath) }
        [IO.File]::Replace($candidate,$ForgeLauncher,[NullString]::Value)
        if ((Get-FileSha256 $ForgeLauncher) -ne $record.PatchedHash) { throw 'Launcher patch verification failed.' }
    } catch {
        if ((Get-FileSha256 $ForgeLauncher) -eq $record.PatchedHash) { Copy-Item -LiteralPath $backup -Destination $ForgeLauncher -Force }
        throw
    } finally {
        if (Test-Path -LiteralPath $candidate) { Remove-Item -LiteralPath $candidate -Force }
        if (Test-Path -LiteralPath $recordCandidate) { Remove-Item -LiteralPath $recordCandidate -Force }
    }
    Write-Host 'Forge launcher patched. Normal launches now load instrumented AI classes and open the live dashboard.' -ForegroundColor Green
    Write-Host ('Original launcher backup: ' + $backup)
}

function Disable-AiForgeIntegration {
    $record = Get-AiIntegrationRecord
    if (-not $record) { Write-Host 'No normal-launch integration is installed.'; return }
    $hash = Get-FileSha256 $ForgeLauncher
    if ($hash -eq $record.OriginalHash) { Write-Host 'The original launcher is already restored.'; return }
    if ($hash -ne $record.PatchedHash) { throw 'Launcher changed after patching. Restore cancelled to preserve those changes.' }
    if (-not (Test-Path -LiteralPath $record.Backup) -or (Get-FileSha256 $record.Backup) -ne $record.OriginalHash) { throw 'Original launcher backup verification failed. Nothing was changed.' }
    $candidate = $ForgeLauncher + '.restore-candidate'
    Copy-Item -LiteralPath $record.Backup -Destination $candidate
    [IO.File]::Replace($candidate,$ForgeLauncher,[NullString]::Value)
    Write-Host 'Original Forge launcher restored. AI Viewer is still available separately.' -ForegroundColor Green
}

function Offer-AiForgeIntegration {
    Write-Host ''
    Write-Host 'OPTIONAL FORGE AI VIEWER' -ForegroundColor Cyan
    Write-Host 'Forge installation is finished. Add live AI statistics to normal Forge launches?'
    Write-Host 'This compiles exact-version AI hooks, backs up Start_Forge.cmd and patches that launcher.'
    Write-Host 'The patch classes run inside Forge. The base JAR and deck files are retained.'
    Write-Host 'You can restore the original launcher from AI Viewer > Restore original launcher.'
    $answer = Read-Host 'Install and integrate AI Viewer now? [y/N]'
    if ($answer -notmatch '^(?i:y|yes)$') { Write-Host 'Skipped. Forge remains installed; AI Viewer can be added later.'; return }
    try { [void](Assert-AiViewerReady) } catch { Setup-AiThoughtViewer }
    Enable-AiForgeIntegration
}

