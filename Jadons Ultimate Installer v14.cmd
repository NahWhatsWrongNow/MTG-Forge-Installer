param([switch]$LibraryOnly)
$ErrorActionPreference='Stop'

function Assert-CleanPath {
    param([string]$Path,[string]$Root,[switch]$Tree)
    $full=[IO.Path]::GetFullPath($Path).TrimEnd('\');$allowed=[IO.Path]::GetFullPath($Root).TrimEnd('\')
    if(-not $full.StartsWith($allowed+'\',[StringComparison]::OrdinalIgnoreCase)){throw ('Unsafe clean-install target: '+$full)}
    $p=$full
    while($p){
        if(Test-Path -LiteralPath $p){$item=Get-Item -LiteralPath $p -Force;if($item.Attributes -band [IO.FileAttributes]::ReparsePoint){throw ('Linked paths are not eligible for clean install: '+$p)}}
        $parent=[IO.Path]::GetDirectoryName($p);if($parent-eq$p){break};$p=$parent
    }
    if($Tree-and(Test-Path -LiteralPath $full -PathType Container)){
        $queue=New-Object 'Collections.Generic.Queue[string]';$queue.Enqueue($full)
        while($queue.Count){foreach($item in Get-ChildItem -LiteralPath $queue.Dequeue() -Force){
            if($item.Attributes-band[IO.FileAttributes]::ReparsePoint){throw ('A selected folder contains a link; nothing has been removed: '+$item.FullName)}
            if($item.PSIsContainer){$queue.Enqueue($item.FullName)}
        }}
    }
    return $full
}

function Get-CleanRoots {
    $local=if($env:LOCALAPPDATA){$env:LOCALAPPDATA}else{Join-Path $env:USERPROFILE 'AppData\Local'}
    $roaming=if($env:APPDATA){$env:APPDATA}else{Join-Path $env:USERPROFILE 'AppData\Roaming'}
    return @{Forge=(Join-Path $local 'MTGForge');Dev=(Join-Path $local 'JadonUniDev');User=$env:USERPROFILE;Decks=(Join-Path $roaming 'Forge')}
}

function Get-CleanOptions {
    param([string]$Package)
    switch($Package){
        'Forge' {return @('Java','Downloads','ImporterSettings')}
        'Betting' {return @('CampaignData','SavedBackups','Runtime','Logs')}
        'AI' {return @('TelemetryHistory','BuildCache')}
        'Python' {return @('ManagedVSCode','VSCodeProfile','Extensions','PythonWorkspace','DevDownloads')}
        'Riftfront' {return @('DevDownloads')}
        default {throw 'Unknown clean-install package.'}
    }
}

function Get-CleanPlan {
    param([string]$Package,[string[]]$Options=@(),[ValidateSet('Keep','Imported','All')][string]$DeckMode='Keep',$Roots=(Get-CleanRoots))
    $valid=@(Get-CleanOptions $Package);foreach($option in $Options){if($option-notin$valid){throw ('Invalid clean-install option: '+$option)}}
    if($DeckMode-ne'Keep'-and$Package-notin@('Forge','Betting')){throw 'Deck removal is available with Forge or A Betting Man.'}
    $items=New-Object Collections.ArrayList
    $add={param($root,$relative,$label);$path=Assert-CleanPath (Join-Path $root $relative) $root;if(Test-Path -LiteralPath $path){[void]$items.Add([pscustomobject]@{Path=$path;Root=$root;Label=$label})}}
    $base=$Roots.Forge;$dev=$Roots.Dev
    switch($Package){
        'Forge' {
            if(Test-Path -LiteralPath $base){foreach($folder in Get-ChildItem -LiteralPath $base -Directory){if($folder.Name-match'^Forge-\d+(?:\.\d+){1,3}(?:[.].+)?$'){&$add $base $folder.Name 'Forge program'}}}
            foreach($p in @('Start_Forge.cmd','Start_Forge.cmd.sha256','Forge_Location.txt')){&$add $base $p 'Forge launcher/location'}
            if('Java'-in$Options){&$add $base 'java-21-jre' 'Forge private Java runtime'}
            if('Downloads'-in$Options){&$add $base 'downloads' 'Forge download cache'}
            if('ImporterSettings'-in$Options){foreach($p in @('settings.json','profiles.txt','import-state.json','scryfall-cache.json')){&$add $base ('ArchidektSync\'+$p) 'Importer settings/history'}}
        }
        'Betting' {
            foreach($p in @('program','version-manifest.txt','Launch_A_Betting_Man.cmd')){&$add $base ('ABettingMan\'+$p) 'A Betting Man application'}
            $map=@{CampaignData='data';SavedBackups='backups';Runtime='runtime';Logs='logs'}
            foreach($option in $Options){&$add $base ('ABettingMan\'+$map[$option]) $option}
        }
        'AI' {
            foreach($p in @('jadon-ai-telemetry-patch.jar','AI_Thought_Dashboard.html','Start_Forge_AI_Viewer.cmd','status.json')){&$add $base ('AIViewer\'+$p) 'AI Viewer component'}
            if('TelemetryHistory'-in$Options){foreach($p in @('sessions','telemetry.jsonl')){&$add $base ('AIViewer\'+$p) 'Recorded AI sessions'}}
            if('BuildCache'-in$Options){foreach($p in @('build','source','classes','downloads','jdk-21')){&$add $base ('AIViewer\'+$p) 'AI build cache'}}
        }
        'Python' {
            &$add $dev 'Python312' 'Portable Python and all installed packages'
            $map=@{ManagedVSCode='VSCode';VSCodeProfile='VSCodeProfile';Extensions='VSCodeExtensions';DevDownloads='downloads'}
            foreach($option in $Options){if($option-eq'PythonWorkspace'){&$add $Roots.User 'PythonUniWorkspace' 'Python workspace INCLUDING user code'}else{&$add $dev $map[$option] $option}}
        }
        'Riftfront' {&$add $Roots.User 'RiftfrontTactics' 'Riftfront project INCLUDING source edits';if('DevDownloads'-in$Options){&$add $dev 'downloads' 'Managed development download cache'}}
    }
    if($DeckMode-ne'Keep'){
        $deckRoot=Join-Path $Roots.Decks 'decks'
        if(Test-Path -LiteralPath $deckRoot){
            [void](Assert-CleanPath $deckRoot $Roots.Decks -Tree)
            foreach($file in Get-ChildItem -LiteralPath $deckRoot -Recurse -File -Filter '*.dck'){
                $owned=$false
                if($DeckMode-eq'Imported'){$text=[IO.File]::ReadAllText($file.FullName);$owned=$text-match'(?m)^Tags=JADON_ARCHIDEKT_IMPORT\s*$'-or($text-match'(?m)^Source URL=https://archidekt[.]com/decks/\d+'-and$text-match"(?m)^Comment=(Imported automatically from Archidekt|Synced from Archidekt by Jadon's Archidekt Deck Sync|Imported by Jadon's Archidekt Forge Manager)")}
                if($DeckMode-eq'All'-or$owned){[void]$items.Add([pscustomobject]@{Path=$file.FullName;Root=$Roots.Decks;Label='Custom deck: '+$file.Name})}
            }
        }
        &$add $base 'ArchidektSync\import-state.json' 'Importer sync index (rebuilt on next import)'
    }
    # Enumerate exact, non-overlapping targets before asking for final consent.
    $unique=@($items|Sort-Object @{Expression={$_.Path.Length}},Path -Unique);$out=New-Object Collections.ArrayList
    foreach($item in $unique){if(-not @($out|Where-Object {$item.Path-eq$_.Path-or$item.Path.StartsWith($_.Path+'\',[StringComparison]::OrdinalIgnoreCase)}).Count){[void]$out.Add($item)}}
    return @($out.ToArray())
}

function Stop-CleanCampaignService {
    param($Roots)
    $file=Join-Path $Roots.Forge 'ABettingMan\runtime\server-control.json'
    if(-not(Test-Path -LiteralPath $file)){return}
    [void](Assert-CleanPath $file $Roots.Forge)
    try{$c=Get-Content -LiteralPath $file -Raw|ConvertFrom-Json}catch{throw 'Campaign control file is unreadable. Close A Betting Man and repair its runtime before cleaning.'}
    if([int]$c.port-lt1024-or[int]$c.port-gt65535){throw 'Invalid campaign service port.'}
    $running=Get-Process -Id ([int]$c.pid) -ErrorAction SilentlyContinue
    if(-not$running){return}
    $h=Invoke-RestMethod -Uri ('http://127.0.0.1:'+$c.port+'/health') -TimeoutSec 3
    $expectedData=[IO.Path]::GetFullPath((Join-Path $Roots.Forge 'ABettingMan\data')).TrimEnd('\')
    if($h.app-ne'A Betting Man'-or[int]$h.pid-ne[int]$c.pid-or-not$h.dataRoot-or[IO.Path]::GetFullPath([string]$h.dataRoot).TrimEnd('\')-ine$expectedData){throw 'Campaign control does not match the installed campaign service.'}
    [void](Invoke-RestMethod -Uri ('http://127.0.0.1:'+$c.port+'/api/shutdown') -Method Post -Headers @{'X-ABM-Token'=[string]$c.token} -ContentType 'application/json' -Body '{}' -TimeoutSec 5)
    for($i=0;$i-lt50;$i++){if(-not(Get-Process -Id ([int]$c.pid) -ErrorAction SilentlyContinue)){return};Start-Sleep -Milliseconds 100}
    throw 'The campaign service is still running. Nothing was removed; close it and try again.'
}

function Assert-CleanProcessesStopped {
    param($Plan)
    $processes=@(Get-CimInstance Win32_Process -ErrorAction Stop)
    foreach($proc in $processes){if($proc.ProcessId-eq$PID){continue};foreach($item in $Plan){
        if(($proc.ExecutablePath-and([string]$proc.ExecutablePath).StartsWith($item.Path,[StringComparison]::OrdinalIgnoreCase))-or($proc.CommandLine-and([string]$proc.CommandLine).IndexOf($item.Path,[StringComparison]::OrdinalIgnoreCase)-ge0)){
            throw ('Close '+$proc.Name+' (PID '+$proc.ProcessId+') before clean install. It is using '+$item.Path)
        }
    }}
}

function Invoke-CleanTransaction {
    param($Plan,[scriptblock]$Reinstall,[string]$JournalRoot)
    $run=(Get-Date -Format 'yyyyMMdd-HHmmssfff')+'-'+[guid]::NewGuid().ToString('N').Substring(0,8)
    $journal=Assert-CleanPath (Join-Path $JournalRoot ('CleanInstallBackups\'+$run)) $JournalRoot
    foreach($item in $Plan){[void](Assert-CleanPath $item.Path $item.Root -Tree)}
    [void](New-Item -ItemType Directory -Path $journal -Force)
    $moved=New-Object Collections.ArrayList;$result=[ordered]@{Status='REMOVING';CreatedAt=(Get-Date).ToString('o');Entries=@();Error=$null}
    $save={ $result.Entries=@($moved.ToArray());[IO.File]::WriteAllText((Join-Path $journal 'recovery.json'),($result|ConvertTo-Json -Depth 6),(New-Object Text.UTF8Encoding($false))) }
    try{
        foreach($item in $Plan){
            if(-not(Test-Path -LiteralPath $item.Path)){continue}
            [void](Assert-CleanPath $item.Path $item.Root -Tree)
            $backup=Assert-CleanPath (Join-Path $item.Root ('CleanInstallBackups\'+$run+'\'+$moved.Count+'-'+[IO.Path]::GetFileName($item.Path))) $item.Root
            [void](New-Item -ItemType Directory -Path (Split-Path -Parent $backup) -Force)
            # Record the exact source/destination before the move so interruption remains recoverable.
            $entry=[pscustomobject]@{Path=$item.Path;Root=$item.Root;Backup=$backup;Label=$item.Label;Moved=$false}
            [void]$moved.Add($entry);&$save
            Move-Item -LiteralPath $item.Path -Destination $backup -ErrorAction Stop;$entry.Moved=$true;&$save
            Write-Host ('Removed from installation: '+$item.Path) -ForegroundColor Yellow
        }
        $result.Status='REINSTALLING';&$save
        &$Reinstall | Out-Host
        $result.Status='COMPLETE';&$save
        Write-Host 'CLEAN INSTALL COMPLETE' -ForegroundColor Green
        Write-Host ('Recovery record: '+(Join-Path $journal 'recovery.json'))
        Write-Host 'Removed items remain in the listed recovery folders; they are not active installation files.'
        return $journal
    }catch{
        $failure=$_.Exception.Message;$result.Status='ROLLING_BACK';$result.Error=$failure;&$save
        $rollbackErrors=New-Object Collections.ArrayList
        for($i=$moved.Count-1;$i-ge0;$i--){$entry=$moved[$i];if(-not(Test-Path -LiteralPath $entry.Backup)){continue}
            try{
                [void](Assert-CleanPath $entry.Backup $entry.Root -Tree);[void](Assert-CleanPath $entry.Path $entry.Root -Tree)
                if(Test-Path -LiteralPath $entry.Path){$failed=$entry.Backup+'.failed-new';[void](Assert-CleanPath $failed $entry.Root);Move-Item -LiteralPath $entry.Path -Destination $failed}
                [void](New-Item -ItemType Directory -Path (Split-Path -Parent $entry.Path) -Force)
                Move-Item -LiteralPath $entry.Backup -Destination $entry.Path
            }catch{[void]$rollbackErrors.Add($_.Exception.Message)}
        }
        $result.Status=if($rollbackErrors.Count){'RECOVERY_REQUIRED'}else{'ROLLED_BACK'};&$save
        throw ('Reinstall failed: '+$failure+'. Previous selected items: '+$result.Status+'. Recovery record: '+$journal+' '+($rollbackErrors-join'; '))
    }
}

function Invoke-CleanInstallerCommand {
    param([string]$Action,[string]$Package)
    if($Action-notin@('--clean-preflight','--clean-reinstall')-or$Package-notin@('Forge','Betting','AI','Python','Riftfront')){throw 'Invalid reinstall command.'}
    if(-not(Test-Path -LiteralPath $env:I7_SELF -PathType Leaf)){throw 'Run clean install from the single CMD installer.'}
    & $env:I7_SELF $Action $Package
    if($LASTEXITCODE-ne0){throw ('Package '+$Action+' failed with exit code '+$LASTEXITCODE)}
}

function Show-CleanInstall {
    $labels=@{Forge='Forge';Betting='A Betting Man';AI='Forge AI Viewer';Python='Portable Python + managed VS Code setup';Riftfront='Riftfront Tactics'}
    $options=@{Java='Private Forge Java runtime';Downloads='Forge download cache';ImporterSettings='Importer settings and saved profiles';CampaignData='ALL campaign saves, players, decks and inventories';SavedBackups='Campaign backups';Runtime='Private Node runtime and service files';Logs='Campaign logs';TelemetryHistory='Recorded AI sessions';BuildCache='AI build/download cache';ManagedVSCode='Managed portable VS Code program (NOT your normal VS Code)';VSCodeProfile='Managed VS Code settings';Extensions='Managed VS Code extensions';PythonWorkspace='Python workspace INCLUDING your own code';DevDownloads='Managed development download cache'}
    $roots=Get-CleanRoots
    Write-Host "`n  CLEAN INSTALL / REMOVE SELECTED ITEMS, THEN REINSTALL" -ForegroundColor Cyan
    Write-Host "  [1] Forge   [2] A Betting Man   [3] AI Viewer`n  [4] Portable Python + VS Code   [5] Riftfront   [0] Back"
    $package=@{'1'='Forge';'2'='Betting';'3'='AI';'4'='Python';'5'='Riftfront'}[(Read-Host 'Choose a package')]
    if(-not$package){return}
    Write-Host ('Selected: '+$labels[$package]) -ForegroundColor Cyan
    Write-Host 'Program files are always removed and reinstalled. Other packages stay in place.'
    if($package-eq'Python'){Write-Host 'Installed portable Python packages will be reset to the full standard bundle.' -ForegroundColor Yellow}
    if($package-eq'Riftfront'){Write-Host 'The whole Riftfront project, including source edits, will be replaced. Browser-local saves are not cleared.' -ForegroundColor Yellow}
    $selected=@();foreach($option in @(Get-CleanOptions $package)){if((Read-Host ('Also remove '+$options[$option]+'? [y/N]'))-match'^(?i:y|yes)$'){$selected+=$option}}
    $decks='Keep'
    if($package-in@('Forge','Betting')){Write-Host "`nCustom Forge decks are SHARED with other campaigns and manual Forge play." -ForegroundColor Yellow;Write-Host '[0] Keep every deck  [1] Remove importer-added decks  [2] Remove ALL custom .dck decks';$d=Read-Host 'Deck choice (default 0)';if($d-eq'1'){$decks='Imported'}elseif($d-eq'2'){$decks='All'}}
    $plan=@(Get-CleanPlan $package $selected $decks $roots)
    Write-Host "`nEXACT REMOVAL LIST" -ForegroundColor Yellow
    foreach($item in $plan){Write-Host ('  '+$item.Label);Write-Host ('    '+$item.Path) -ForegroundColor DarkGray}
    if(-not$plan.Count){Write-Host 'No installed files were found; the selected package will be installed.'}
    Write-Host "`nRemoved files will be moved out of the installation into recovery folders before reinstalling. This is NOT a disk-space cleanup. Downloads/exports and unselected data are kept."
    Write-Host 'Close the selected program first. The campaign service will be stopped safely if needed.'
    if((Read-Host ('Type CLEAN '+$package+' to confirm, or Enter to cancel'))-cne('CLEAN '+$package)){Write-Host 'Cancelled. Nothing removed.';return}
    Invoke-CleanInstallerCommand '--clean-preflight' $package
    if($package-eq'Betting'-or$decks-ne'Keep'){Stop-CleanCampaignService $roots}
    Assert-CleanProcessesStopped $plan
    [void](Invoke-CleanTransaction $plan {Invoke-CleanInstallerCommand '--clean-reinstall' $package} $roots.Forge)
}

if(-not$LibraryOnly){try{Show-CleanInstall;exit 0}catch{Write-Host $_.Exception.Message -ForegroundColor Red;exit 1}}
