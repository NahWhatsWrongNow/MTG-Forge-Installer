set "I7_BETTING_CANDIDATE=%I7_BASE%\A_Betting_Man_Manager_v14.candidate.cmd"
set "I7_DEV_SHA=0d8630bb9a6c2f1854bc8033285f2e58a05dc0ab272ccea8822db32908975319"
set "I7_BETTING_SHA=322224d5d6ad061d30a9f0467d5fcd38382865dec54b56eee6ce6529cc834aa2"
set "I7_SAFE_CMD=%I7_TOOL%\Safe_Archidekt_Importer_v4.cmd"
set "I7_SAFE_CMD_CANDIDATE=%I7_TOOL%\Safe_Archidekt_Importer_v4.candidate.cmd"
set "I7_SAFE_PS=%I7_TOOL%\Safe_Archidekt_Importer_v4.payload"
set "I7_SAFE_PS_CANDIDATE=%I7_TOOL%\Safe_Archidekt_Importer_v4.candidate.payload"
set "I7_LEGACY=%I7_BASE%\LegacyInstaller_v8.compat.cmd"
set "I7_LEGACY_CANDIDATE=%I7_BASE%\LegacyInstaller_v8.candidate.cmd"
set "I7_LAUNCHER=%I7_BASE%\Start_Forge.cmd"
set "I7_CORE_SHA=48ef2aeb085e26ffe04c4b08f8cbf594d16d37d14a7ead37b8e59d613f2d84f4"
set "I7_MANAGER_SHA=e5fe7c501136f7d541a8d669bfd83fadf3f61fb31b5d21f456c9cf0b95ac00e6"
set "I7_SAFE_CMD_SHA=3fdb666ff2b2f87e33f787d52c29601fee7ff965f0df459ee74d220b87be41be"
set "I7_SAFE_PS_SHA=2e8aab791f933f0e7409b23463ada24250bf5caebabb826f00765c1c87050e7c"
set "I7_LEGACY_SHA=ac8ebde5c795e981f6383acc62ac4cd19c29ad8056ffb07ddd3e92e6bf9bcb85"
set "I7_AUTOTEST=0"
if /I "%~1"=="--test" set "I7_AUTOTEST=1"

call :I7_INITIALIZE
if errorlevel 1 goto :I7_INIT_FAILED

if /I "%~1"=="--v14-prepare" goto :I12_CHILD
if /I "%~1"=="--clean-preflight" goto :I14_CLEAN_PREFLIGHT
if /I "%~1"=="--clean-reinstall" goto :I14_CLEAN_REINSTALL
if "%I7_AUTOTEST%"=="1" goto :I7_AUTOMATED_TEST
call :I12_PRESENT welcome
goto :I7_HOME_MENU

:I14_CLEAN_MENU
"%I7_PS_EXE%" -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$r=[IO.File]::ReadAllText($env:I7_SELF);$b='###JADON_CLEAN_V14_BEGIN###';$e='###JADON_CLEAN_V14_END###';$bm=[regex]::Matches($r,'(?m)^'+[regex]::Escape($b)+'\r?$');$em=[regex]::Matches($r,'(?m)^'+[regex]::Escape($e)+'\r?$');if($bm.Count-ne1-or$em.Count-ne1-or$em[0].Index-le$bm[0].Index){throw 'Clean install payload invalid'};$body=$r.Substring($bm[0].Index+$b.Length,$em[0].Index-$bm[0].Index-$b.Length).Trim([char]13,[char]10);$sha=[Security.Cryptography.SHA256]::Create();try{$hash=([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($body)))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()};if($hash-ne$env:I14_CLEAN_SHA){throw 'Clean install integrity check failed'};&([scriptblock]::Create($body))"
pause
goto :I7_HOME_MENU

:I14_CLEAN_PREFLIGHT
if /I "%~2"=="Forge" goto :I14_CLEAN_CHECK_FORGE
if /I "%~2"=="Betting" goto :I14_CLEAN_CHECK_BETTING
if /I "%~2"=="AI" goto :I14_CLEAN_CHECK_AI
if /I "%~2"=="Python" goto :I14_CLEAN_CHECK_DEV
if /I "%~2"=="Riftfront" goto :I14_CLEAN_CHECK_DEV
exit /b 1
:I14_CLEAN_CHECK_FORGE
call :I7_PREPARE_CORE
if errorlevel 1 exit /b 1
call :I7_EXTRACT_MANAGER
exit /b %ERRORLEVEL%
:I14_CLEAN_CHECK_BETTING
call :I7_PREPARE_BETTING
exit /b %ERRORLEVEL%
:I14_CLEAN_CHECK_AI
call :I7_EXTRACT_MANAGER
exit /b %ERRORLEVEL%
:I14_CLEAN_CHECK_DEV
call :I7_PREPARE_DEV
exit /b %ERRORLEVEL%

:I14_CLEAN_REINSTALL
if /I "%~2"=="Forge" goto :I14_CLEAN_FORGE
if /I "%~2"=="Betting" goto :I14_CLEAN_BETTING
if /I "%~2"=="AI" goto :I14_CLEAN_AI
if /I "%~2"=="Python" goto :I14_CLEAN_DEV
if /I "%~2"=="Riftfront" goto :I14_CLEAN_DEV
exit /b 1
:I14_CLEAN_FORGE
call :I7_PREPARE_CORE
if errorlevel 1 exit /b 1
call :I7_INVOKE_CORE "%I7_CORE%" Install SCHOOL
if errorlevel 1 exit /b 1
call :I7_EXTRACT_MANAGER
if errorlevel 1 exit /b 1
call :I7_PREPARE_SAFE
if errorlevel 1 exit /b 1
call :I7_PREPARE_LEGACY
if errorlevel 1 exit /b 1
set "JADON_AI_POSTINSTALL=1"
call "%I7_MANAGER%"
set "JADON_AI_POSTINSTALL="
exit /b 0
:I14_CLEAN_BETTING
call :I7_PREPARE_BETTING
if errorlevel 1 exit /b 1
call "%I7_BETTING%" --prepare-only
exit /b %ERRORLEVEL%
:I14_CLEAN_AI
call :I7_EXTRACT_MANAGER
if errorlevel 1 exit /b 1
set "JADON_CLEAN_AI=1"
call "%I7_MANAGER%"
set "I14_CLEAN_RC=%ERRORLEVEL%"
set "JADON_CLEAN_AI="
exit /b %I14_CLEAN_RC%
:I14_CLEAN_DEV
call :I7_PREPARE_DEV
if errorlevel 1 exit /b 1
call "%I7_DEV%" --clean-reinstall "%~2"
exit /b %ERRORLEVEL%
:I13_REGULARS
set "JADON_DECK_ACTION=Regulars"
goto :I13_DECK_ACTION
:I13_UPDATE
set "JADON_DECK_ACTION=Update"
:I13_DECK_ACTION
call :I7_RUN_MANAGER
set "JADON_DECK_ACTION="
goto :I7_HOME_MENU

:I12_PRESENT
set "I12_MODE=%~1"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command "$r=[IO.File]::ReadAllText($env:I7_SELF);$b='###JADON_V14_CONSOLE_BEGIN###';$e='###JADON_V14_CONSOLE_END###';$i=[regex]::Match($r,'(?m)^'+[regex]::Escape($b)+'\r?$').Index;$j=[regex]::Match($r,'(?m)^'+[regex]::Escape($e)+'\r?$').Index;if($i-lt1-or$j-le$i){exit 1};& ([Scriptblock]::Create($r.Substring($i+$b.Length,$j-$i-$b.Length)))"
exit /b %ERRORLEVEL%

:I12_PREPARE
if "%I7_AUTOTEST%"=="1" goto :I12_DIRECT
set "I12_TASK=%~1"
call :I12_PRESENT radar
exit /b %ERRORLEVEL%
:I12_DIRECT
call :I12_DISPATCH %~1
exit /b %ERRORLEVEL%

:I12_CHILD
call :I12_DISPATCH %~2
exit /b %ERRORLEVEL%
:I12_DISPATCH
if /I "%~1"=="CORE" goto :I12_CORE
if /I "%~1"=="SAFE" goto :I12_SAFE
if /I "%~1"=="LEGACY" goto :I12_LEGACY
if /I "%~1"=="MANAGER" goto :I12_MANAGER
if /I "%~1"=="DEV" goto :I12_DEV
if /I "%~1"=="BETTING" goto :I12_BETTING
exit /b 1
:I12_CORE
call :I7_PREPARE_CORE
exit /b %ERRORLEVEL%
:I12_SAFE
call :I7_PREPARE_SAFE
exit /b %ERRORLEVEL%
:I12_LEGACY
call :I7_PREPARE_LEGACY
exit /b %ERRORLEVEL%
:I12_MANAGER
call :I7_EXTRACT_MANAGER
exit /b %ERRORLEVEL%
:I12_DEV
call :I7_PREPARE_DEV
exit /b %ERRORLEVEL%
:I12_BETTING
call :I7_PREPARE_BETTING
exit /b %ERRORLEVEL%

:I12_THEMES
cls
echo.
echo     YOUR CONSOLE / YOUR STYLE
echo.
echo     [1] Aurora   - green and cyan
echo     [2] Amber    - warm gold
echo     [3] Violet   - magenta and blue
echo     [4] Ice      - cyan and white
echo     [0] Back
echo.
choice /C 12340 /N /M "Choose a theme: "
set "I12_THEME_CHOICE=%ERRORLEVEL%"
if "%I12_THEME_CHOICE%"=="5" goto :I7_HOME_MENU
if "%I12_THEME_CHOICE%"=="1" set "I12_THEME=aurora"
if "%I12_THEME_CHOICE%"=="2" set "I12_THEME=amber"
if "%I12_THEME_CHOICE%"=="3" set "I12_THEME=violet"
if "%I12_THEME_CHOICE%"=="4" set "I12_THEME=ice"
call :I12_PRESENT theme
goto :I7_HOME_MENU
:I7_HOME_MENU
call :I7_CHECK_MEMORY_READY
call :I12_PRESENT menu
if errorlevel 1 (
  echo Jadon's Ultimate Installer V14
  echo [1] School [2] Normal [3] Forge [4] Manager [5] Repair [6] Import
  echo [7] Memory [8] View Memory [9] Uninstall [D] UniDev [B] Betting Man
  echo [R] Regulars [U] Update [C] Clean install [T] Themes [0] Exit
)
if not exist "%SystemRoot%\System32\choice.exe" goto :I7_CHOICE_MISSING
"%SystemRoot%\System32\choice.exe" /C 123456789DBTRUC0 /N /M "Choose an option: "
set "I7_CHOICE=%ERRORLEVEL%"
if "%I7_CHOICE%"=="16" goto :I7_END
if "%I7_CHOICE%"=="15" goto :I14_CLEAN_MENU
if "%I7_CHOICE%"=="13" goto :I13_REGULARS
if "%I7_CHOICE%"=="14" goto :I13_UPDATE
if "%I7_CHOICE%"=="12" goto :I12_THEMES
if "%I7_CHOICE%"=="11" goto :I7_MENU_BETTING
if "%I7_CHOICE%"=="10" goto :I7_MENU_DEV
if "%I7_CHOICE%"=="9" goto :I7_MENU_UNINSTALL
if "%I7_CHOICE%"=="8" goto :I7_MENU_MEMORY_VIEW
if "%I7_CHOICE%"=="7" goto :I7_MENU_MEMORY
if "%I7_CHOICE%"=="6" goto :I7_MENU_SAFE
if "%I7_CHOICE%"=="5" goto :I7_MENU_DIAGNOSTICS
if "%I7_CHOICE%"=="4" goto :I7_MENU_MANAGER
if "%I7_CHOICE%"=="3" goto :I7_MENU_FORGE
if "%I7_CHOICE%"=="2" goto :I7_MENU_NORMAL
if "%I7_CHOICE%"=="1" goto :I7_MENU_SCHOOL
set "I7_FAIL_MESSAGE=The menu choice command returned an invalid result."
call :I7_SHOW_FAILURE
goto :I7_HOME_MENU

:I7_MENU_SCHOOL
set "I7_INSTALL_MODE=SCHOOL"
call :I7_RUN_INSTALL
goto :I7_HOME_MENU

:I7_MENU_NORMAL
set "I7_INSTALL_MODE=NORMAL"
call :I7_RUN_INSTALL
goto :I7_HOME_MENU

:I7_MENU_FORGE
call :I7_RUN_FORGE
goto :I7_HOME_MENU

:I7_MENU_MANAGER
call :I7_RUN_MANAGER
goto :I7_HOME_MENU

:I7_MENU_DIAGNOSTICS
call :I7_DIAGNOSTICS
goto :I7_HOME_MENU

:I7_MENU_SAFE
call :I7_RUN_SAFE
goto :I7_HOME_MENU

:I7_MENU_MEMORY
call :I7_READ_MEMORY
goto :I7_HOME_MENU

:I7_MENU_MEMORY_VIEW
call :I7_VIEW_MEMORY
goto :I7_HOME_MENU

:I7_MENU_UNINSTALL
call :I7_CONFIGURED_UNINSTALL
goto :I7_HOME_MENU

:I7_MENU_BETTING
call :I12_PREPARE BETTING
if errorlevel 1 (
    set "I7_FAIL_MESSAGE=A Betting Man failed candidate and last-good validation. Forge, UniDev, Riftfront, and campaign data were retained."
    call :I7_SHOW_FAILURE
    goto :I7_HOME_MENU
)
call "%I7_BETTING%"
if errorlevel 1 (
    set "I7_FAIL_MESSAGE=A Betting Man returned an error. Its manager log and every committed campaign record were retained."
    call :I7_SHOW_FAILURE
)
goto :I7_HOME_MENU

:I7_PREPARE_BETTING
del /f /q "%I7_BETTING_CANDIDATE%" >nul 2>&1
set "PS_I7_SELF=%I7_SELF%"
set "PS_I7_BETTING_OUT=%I7_BETTING_CANDIDATE%"
set "PS_I7_BETTING_SHA=%I7_BETTING_SHA%"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$r=[IO.File]::ReadAllText($env:PS_I7_SELF);$b='###JADON_BETTING_MAN_V14_BEGIN###';$e='###JADON_BETTING_MAN_V14_END###';$bi=$r.LastIndexOf($b);$ei=$r.LastIndexOf($e);if($bi-lt0-or$ei-le$bi){throw 'A Betting Man markers are invalid'};$body=$r.Substring($bi+$b.Length,$ei-$bi-$b.Length).TrimStart([char]13,[char]10);[IO.File]::WriteAllText($env:PS_I7_BETTING_OUT,$body,(New-Object Text.ASCIIEncoding));$a=[Security.Cryptography.SHA256]::Create();$s=[IO.File]::OpenRead($env:PS_I7_BETTING_OUT);try{$h=([BitConverter]::ToString($a.ComputeHash($s))).Replace('-','').ToLowerInvariant()}finally{$s.Dispose();$a.Dispose()};if($h-ne$env:PS_I7_BETTING_SHA){throw ('A Betting Man manager hash mismatch: '+$h)}"
if errorlevel 1 goto :I7_BETTING_CANDIDATE_FAILED
call "%I7_BETTING_CANDIDATE%" --selftest
if errorlevel 1 goto :I7_BETTING_CANDIDATE_FAILED
set "PS_I7_CANDIDATE=%I7_BETTING_CANDIDATE%"
set "PS_I7_LIVE=%I7_BETTING%"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$c=$env:PS_I7_CANDIDATE;$l=$env:PS_I7_LIVE;if(Test-Path -LiteralPath $l){$b=$l+'.last-good-'+(Get-Date -Format 'yyyyMMdd-HHmmssfff');[IO.File]::Replace($c,$l,$b,$true)}else{[IO.File]::Move($c,$l)}"
exit /b %ERRORLEVEL%

:I7_BETTING_CANDIDATE_FAILED
del /f /q "%I7_BETTING_CANDIDATE%" >nul 2>&1
if not exist "%I7_BETTING%" exit /b 1
set "PS_I7_BETTING_LIVE=%I7_BETTING%"
set "PS_I7_BETTING_SHA=%I7_BETTING_SHA%"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command "$a=[Security.Cryptography.SHA256]::Create();$s=[IO.File]::OpenRead($env:PS_I7_BETTING_LIVE);try{$h=([BitConverter]::ToString($a.ComputeHash($s))).Replace('-','').ToLowerInvariant()}finally{$s.Dispose();$a.Dispose()};if($h-ne$env:PS_I7_BETTING_SHA){exit 1}"
if errorlevel 1 exit /b 1
call "%I7_BETTING%" --selftest
exit /b %ERRORLEVEL%
:I7_MENU_DEV
call :I12_PREPARE DEV
if errorlevel 1 (
    set "I7_FAIL_MESSAGE=The embedded University Development Manager failed integrity validation."
    call :I7_SHOW_FAILURE
    goto :I7_HOME_MENU
)
call "%I7_DEV%"
goto :I7_HOME_MENU

:I7_PREPARE_DEV
set "PS_I7_SELF=%I7_SELF%"
set "PS_I7_DEV_OUT=%I7_DEV_CANDIDATE%"
set "PS_I7_DEV_SHA=%I7_DEV_SHA%"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command ^
 "$ErrorActionPreference='Stop';$raw=[IO.File]::ReadAllText($env:PS_I7_SELF);$b='###JADON_UNIDEV_V10_BEGIN###';$e='###JADON_UNIDEV_V10_END###';$bi=$raw.LastIndexOf($b);$ei=$raw.LastIndexOf($e);if($bi-lt0-or$ei-le$bi){throw 'University development payload markers are invalid.'};" ^
 "$body=$raw.Substring($bi+$b.Length,$ei-($bi+$b.Length)).TrimStart([char]13,[char]10);[IO.File]::WriteAllText($env:PS_I7_DEV_OUT,$body,(New-Object Text.ASCIIEncoding));$a=[Security.Cryptography.SHA256]::Create();$s=[IO.File]::OpenRead($env:PS_I7_DEV_OUT);try{$h=([BitConverter]::ToString($a.ComputeHash($s))).Replace('-','').ToLowerInvariant()}finally{$s.Dispose();$a.Dispose()};if($h-ne$env:PS_I7_DEV_SHA){throw ('University development payload hash mismatch: '+$h)}"
if errorlevel 1 exit /b 1
call "%I7_DEV_CANDIDATE%" --selftest
if errorlevel 1 exit /b 1
set "PS_I7_DEV_CANDIDATE=%I7_DEV_CANDIDATE%"
set "PS_I7_DEV_LIVE=%I7_DEV%"
"%I7_PS_EXE%" -NoLogo -NoProfile -Command ^
 "$ErrorActionPreference='Stop';$c=$env:PS_I7_DEV_CANDIDATE;$l=$env:PS_I7_DEV_LIVE;if(Test-Path -LiteralPath $l){$b=$l+'.last-good-'+(Get-Date -Format 'yyyyMMdd-HHmmssfff');[IO.File]::Replace($c,$l,$b,$true)}else{[IO.File]::Move($c,$l)}"
exit /b %ERRORLEVEL%

:I7_RUN_INSTALL
echo.
echo Selected: %I7_INSTALL_MODE% INSTALL
if /I "%I7_INSTALL_MODE%"=="SCHOOL" echo No BITS, installer GUI, shortcuts, elevation, registry commands, or permanent PATH changes will be used.
echo.

call :I12_PREPARE CORE
if errorlevel 1 goto :I7_INSTALL_CORE_FAILED

call :I7_INVOKE_CORE "%I7_CORE%" Install "%I7_INSTALL_MODE%"
set "I7_INSTALL_RC=%ERRORLEVEL%"
if not "%I7_INSTALL_RC%"=="0" goto :I7_INSTALL_OPERATION_FAILED

echo.
echo [7/8] Installing independently validated V9 manager and attached fallback...
call :I12_PREPARE SAFE
set "I7_INSTALL_SAFE_RC=%ERRORLEVEL%"
call :I12_PREPARE LEGACY
set "I7_INSTALL_LEGACY_RC=%ERRORLEVEL%"
call :I12_PREPARE MANAGER
set "I7_INSTALL_MANAGER_RC=%ERRORLEVEL%"

if not "%I7_INSTALL_SAFE_RC%"=="0" call :I7_INSTALL_SAFE_WARNING
if not "%I7_INSTALL_LEGACY_RC%"=="0" call :I7_INSTALL_LEGACY_WARNING
if not "%I7_INSTALL_MANAGER_RC%"=="0" call :I7_INSTALL_MANAGER_WARNING

if /I "%I7_INSTALL_MODE%"=="NORMAL" if "%I7_INSTALL_MANAGER_RC%"=="0" call :I7_CREATE_MANAGER_SHORTCUT

echo.
echo ================================================================
echo INSTALLATION COMPLETE
echo ================================================================
echo.
if exist "%I7_BASE%\Forge_Location.txt" type "%I7_BASE%\Forge_Location.txt"
echo.
if "%I7_INSTALL_MANAGER_RC%"=="0" echo Ultimate Forge Manager v7: READY
if not "%I7_INSTALL_MANAGER_RC%"=="0" echo Ultimate Forge Manager v7: candidate failed; previous copy retained
if "%I7_INSTALL_SAFE_RC%"=="0" echo Proven safe V4 importer: VERIFIED
if not "%I7_INSTALL_SAFE_RC%"=="0" echo Proven safe V4 importer: verification failed; previous copy retained
if "%I7_INSTALL_LEGACY_RC%"=="0" echo Attached v8 compatibility installer: VERIFIED
if not "%I7_INSTALL_LEGACY_RC%"=="0" echo Attached v8 compatibility installer: unavailable
echo Installer log:
set I7_INSTALL_LOG
echo.
set "JADON_AI_POSTINSTALL=1"
if "%I7_INSTALL_MANAGER_RC%"=="0" call "%I7_MANAGER%"
set "JADON_AI_POSTINSTALL="
echo No administrator installation or permanent PATH change was used.
if /I "%I7_INSTALL_MODE%"=="SCHOOL" echo School safeguards remained active for the entire install.
echo.
pause
exit /b 0

:I7_INSTALL_CORE_FAILED
set "I7_FAIL_MESSAGE=The V9 installer core candidate failed extraction, parser validation, or self-test."
call :I7_SHOW_FAILURE
call :I7_RUN_LEGACY_FALLBACK
exit /b %ERRORLEVEL%

:I7_INSTALL_OPERATION_FAILED
set "I7_FAIL_MESSAGE=Forge installation or repair failed. Existing working files were retained whenever possible."
call :I7_SHOW_FAILURE
call :I7_RUN_LEGACY_FALLBACK
exit /b %ERRORLEVEL%

:I7_INSTALL_SAFE_WARNING
echo.
echo WARNING: The proven-safe importer candidate could not be refreshed.
echo Any previous verified live copy was left untouched.
call :I7_LOG_FIXED "Safe importer refresh failed during install."
exit /b 0

:I7_INSTALL_MANAGER_WARNING
echo.
echo WARNING: The V9 manager candidate did not pass all validation.
echo Forge remains usable and any prior manager copy was left untouched.
call :I7_LOG_FIXED "Manager refresh failed during install."
exit /b 0

:I7_INSTALL_LEGACY_WARNING
echo.
echo WARNING: The attached v8 compatibility fallback could not be refreshed.
echo Primary Forge and importer features remain available.
call :I7_LOG_FIXED "Attached v8 fallback refresh failed during install."
exit /b 0

:I7_CREATE_MANAGER_SHORTCUT
call :I7_INVOKE_CORE "%I7_CORE%" ManagerShortcut NORMAL
if errorlevel 1 call :I7_LOG_FIXED "Manager desktop shortcut was not created."
exit /b 0

:I7_RUN_FORGE
echo.
call :I12_PREPARE CORE
if errorlevel 1 goto :I7_RUN_FORGE_CORE_FAILED
call :I7_INVOKE_CORE "%I7_CORE%" RunForge SCHOOL
set "I7_FORGE_RC=%ERRORLEVEL%"
if "%I7_FORGE_RC%"=="0" exit /b 0
set "I7_FAIL_MESSAGE=Forge could not be launched. The normal installation was not modified."
call :I7_SHOW_FAILURE
exit /b 1

:I7_RUN_FORGE_CORE_FAILED
set "I7_FAIL_MESSAGE=The validated installer core was unavailable, so Forge launch was stopped safely."
call :I7_SHOW_FAILURE
exit /b 1

:I7_RUN_MANAGER
echo.
echo Preparing the V9 manager candidate...
call :I12_PREPARE LEGACY >nul 2>&1
call :I12_PREPARE MANAGER
if errorlevel 1 goto :I7_MANAGER_PREP_FAILED

