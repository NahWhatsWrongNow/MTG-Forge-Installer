$lblChosen = New-Object System.Windows.Forms.Label
$lblChosen.Text = "Chosen action: -"
$lblChosen.AutoSize = $true
$lblChosen.Font = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Bold)

