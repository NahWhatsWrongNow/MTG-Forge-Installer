$lastLine = 0
$decisionNumber = 0

function Add-GridRow {
    param($Type, $Action, $Status, $Score, $Available)

    [void]$grid.Rows.Add(
        [string]$Type,
        [string]$Action,
        [string]$Status,
        [string]$Score,
        [string]$Available
    )

    if ($grid.Rows.Count -gt 250) {
        $grid.Rows.RemoveAt(0)
    }
