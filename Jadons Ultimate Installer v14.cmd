function Import-Regulars {
    Write-UiBanner "IMPORT REGULARS" ($DefaultProfiles -join "  /  ")
    Write-Host "  Imports missing decks. Existing decks stay untouched." -ForegroundColor Cyan
    if ((Read-Host "  Import all three profiles? [Y/n]") -match '^(?i:n|no)$') { return }
    $previousCopy = $Settings.CopyDetection
    $results = @()
    try {
        $Settings.CopyDetection = $true
        foreach ($profile in $DefaultProfiles) {
            $script:ProfileImportNeedsFallback = $false
            try {
                Sync-Profile $profile
                $status = if ($script:ProfileImportNeedsFallback) { "Needs retry - see log" } else { "Finished - see import summary" }
            } catch { $status = "Failed: " + $_.Exception.Message }
            $results += [pscustomobject]@{Profile=$profile; Status=$status}
        }
    } finally { $Settings.CopyDetection = $previousCopy }
    Write-UiSection "Regulars / summary"
    foreach ($result in $results) { Write-Host ("  " + $result.Profile + "  /  " + $result.Status) -ForegroundColor Cyan }
}

function Read-AdvancedDeckFilters {
    $filters = [pscustomobject]@{NameContains=""; NameExcludes=""; Owner=""; ExcludeOwner="";
        MaximumViews=0; CreatedDays=0; CommanderContains=""; RequiredCards=@(); ExcludedCards=@();
        Colors=""; ColorMode="Within"; MinLands=0; MaxLands=100}
    if ((Read-Host "  Advanced filters? [y/N]") -notmatch '^(?i:y|yes)$') { return $filters }
    Write-UiSection "Search / advanced"
    Write-Host "  Leave text fields blank to ignore them." -ForegroundColor DarkGray
    $filters.NameContains = (Read-Host "  Deck name contains").Trim()
    $filters.NameExcludes = (Read-Host "  Deck name excludes").Trim()
    $filters.Owner = (Read-Host "  Only this username").Trim()
    $filters.ExcludeOwner = (Read-Host "  Exclude this username").Trim()
    $filters.MaximumViews = Read-IntegerWithDefault "  Maximum views (0 = any)" 0 100000000 0
    $filters.CreatedDays = Read-IntegerWithDefault "  Created within days (0 = any)" 0 36500 0
    $filters.CommanderContains = (Read-Host "  Commander name contains").Trim()
    $filters.RequiredCards = @((Read-Host "  Must include ALL cards (exact names; separate with semicolons)") -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    $filters.ExcludedCards = @((Read-Host "  Exclude ANY cards (exact names; separate with semicolons)") -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    do { $colors = (Read-Host "  Allowed colour identity (WUBRG, C, or blank)").Trim().ToUpperInvariant() } while ($colors -and $colors -notmatch '^(?:[WUBRG]+|C)$')
    $filters.Colors = $colors
    if ($colors) {
        $mode = Read-IntegerWithDefault "  Colours: [1] Within these colours [2] Exactly these colours" 1 2 1
        if ($mode -eq 2) { $filters.ColorMode = "Exact" }
    }
    $filters.MinLands = Read-IntegerWithDefault "  Minimum lands" 0 100 0
    $filters.MaxLands = Read-IntegerWithDefault "  Maximum lands" $filters.MinLands 100 100
    return $filters
}

function Test-AdvancedMetaFilters {
    param($Meta, $Filters)
    if (-not $Filters) { return "" }
    $name = [string](Get-Prop $Meta "name")
    if ($Filters.NameContains -and $name.IndexOf($Filters.NameContains, [StringComparison]::OrdinalIgnoreCase) -lt 0) { return "Name" }
    if ($Filters.NameExcludes -and $name.IndexOf($Filters.NameExcludes, [StringComparison]::OrdinalIgnoreCase) -ge 0) { return "Name" }
    $owner = Get-DeckOwnerName $Meta $Meta
    if ($Filters.Owner -and $owner -ine $Filters.Owner) { return "Owner" }
    if ($Filters.ExcludeOwner -and $owner -ieq $Filters.ExcludeOwner) { return "Owner" }
    if ($Filters.MaximumViews -gt 0 -and (Get-IntegerMetaValue $Meta @("viewCount", "view_count") 0) -gt $Filters.MaximumViews) { return "Views" }
    if ($Filters.CreatedDays -gt 0) {
        $created = [DateTime]::MinValue
        if (-not [DateTime]::TryParse([string](Get-Prop $Meta "createdAt"), [ref]$created) -or $created.ToUniversalTime() -lt [DateTime]::UtcNow.AddDays(-$Filters.CreatedDays)) { return "Created" }
    }
    return ""
}

function Get-ExactDeckSections {
    param([string[]]$Lines)
    $vector = @{}
    $section = ""
    foreach ($line in $Lines) {
        if ($line -match '^\s*\[(.+)\]\s*$') { $section = $Matches[1].ToLowerInvariant(); continue }
        if ($section -notin @("main", "commander", "sideboard")) { continue }
        if ([string]::IsNullOrWhiteSpace($line) -or $line.TrimStart().StartsWith('#')) { continue }
        if ($line -notmatch '^\s*(\d+)\s+([^|]+)(?:\|.*)?$') { throw "Unrecognized card line in [$section]: $line" }
        $qty = [int]$Matches[1]
        $name = $Matches[2].Trim().ToLowerInvariant()
        if ($qty -lt 1 -or -not $name) { throw "Invalid card quantity or name." }
        $key = $section + "|" + $name
        if (-not $vector.ContainsKey($key)) { $vector[$key] = 0 }
        $vector[$key] += $qty
    }
    if ($vector.Count -eq 0) { throw "Deck has no readable cards." }
    return $vector
}

function Get-ExactDeckChanges {
    param([string[]]$Before, [string[]]$After)
    $old = Get-ExactDeckSections $Before
    $new = Get-ExactDeckSections $After
    foreach ($key in @(@($old.Keys) + @($new.Keys) | Sort-Object -Unique)) {
        $difference = [int]$new[$key] - [int]$old[$key]
        if ($difference -ne 0) {
            $parts = $key -split '\|', 2
            [pscustomobject]@{Section=$parts[0]; Name=$parts[1]; Delta=$difference}
        }
    }
}

function Test-AdvancedDetailFilters {
    param($Prepared, $Filters)
    if (-not $Filters) { return "" }
    if ($Filters.CommanderContains -and ([string]$Prepared.CommanderLabel).IndexOf($Filters.CommanderContains, [StringComparison]::OrdinalIgnoreCase) -lt 0) { return "Commander" }
    $vector = Get-ExactDeckSections $Prepared.DeckLines
    $names = @{}
    foreach ($key in $vector.Keys) { if ($key -notlike 'sideboard|*') { $names[($key -split '\|',2)[1]] = $true } }
    foreach ($name in $Filters.RequiredCards) { if (-not $names.ContainsKey($name.ToLowerInvariant())) { return "Required cards" } }
    foreach ($name in $Filters.ExcludedCards) { if ($names.ContainsKey($name.ToLowerInvariant())) { return "Excluded cards" } }
    if (-not $Filters.Colors -and $Filters.MinLands -eq 0 -and $Filters.MaxLands -eq 100) { return "" }
    $byName = @{}
    foreach ($card in $script:ScryfallCache.Values) {
        $forgeName = Get-ForgeCardName ([string]$card.name) $card
        if ($forgeName) { $byName[$forgeName.ToLowerInvariant()] = $card }
    }
    $identity = @{}
    $lands = 0
    foreach ($key in $vector.Keys) {
        if ($key -like 'sideboard|*') { continue }
        $name = ($key -split '\|',2)[1]
        if (-not $byName.ContainsKey($name)) { return "Card metadata unavailable" }
        $card = $byName[$name]
        foreach ($color in @(Get-Prop $card "color_identity")) { $identity[[string]$color] = $true }
        if ([string](Get-Prop $card "type_line") -match '\bLand\b') { $lands += [int]$vector[$key] }
    }
    if ($lands -lt $Filters.MinLands -or $lands -gt $Filters.MaxLands) { return "Land count" }
    if ($Filters.Colors) {
        $allowed = $Filters.Colors.Replace('C','')
        foreach ($color in $identity.Keys) { if (-not $allowed.Contains($color)) { return "Colour identity" } }
        if ($Filters.ColorMode -eq "Exact") {
            foreach ($color in $allowed.ToCharArray()) { if (-not $identity.ContainsKey([string]$color)) { return "Colour identity" } }
        }
    }
    return ""
}

function Get-ProfileUpdateCandidates {
    param([string]$Username, [int]$Limit = 0)
    $seen = @{}
    $collected = New-Object System.Collections.ArrayList
    $encoded = [Uri]::EscapeDataString($Username)
    for ($page = 1; ; $page++) {
        $data = Invoke-JsonGet "https://archidekt.com/api/decks/v3/?ownerUsername=$encoded&orderBy=-updatedAt&pageSize=50&page=$page"
        if ($null -eq (Get-Prop $data "results")) { throw "Archidekt returned an invalid profile list." }
        $added = 0
        foreach ($meta in @($data.results)) {
            $id = [string](Get-Prop $meta "id")
            if ($id -notmatch '^\d+$' -or $seen.ContainsKey($id)) { continue }
            $seen[$id] = $true; $added++
            [void]$collected.Add($meta)
            if ($Limit -gt 0 -and $collected.Count -ge $Limit) { return $collected.ToArray() }
        }
        Show-UiProgress "Finding recent decks" $collected.Count 0 $Username
        if (-not (Get-Prop $data "next")) { break }
        if ($added -eq 0) { throw "Archidekt repeated a page. Retry when the service recovers." }
        Wait-ApiPacing
    }
    return $collected.ToArray()
}

function Save-VerifiedDeckUpdate {
    param([string]$Path, [string]$Id, [string]$ExpectedHash, [string[]]$Lines)
    $resolved = [IO.Path]::GetFullPath($Path)
    $parent = [IO.Path]::GetDirectoryName($resolved)
    if ($parent -notin @([IO.Path]::GetFullPath($CommanderDir), [IO.Path]::GetFullPath($ConstructedDir))) { throw "Deck is outside the managed deck folders." }
    if (-not (Test-IsOurImportedDeckFile $resolved)) { throw "Deck is not importer-owned." }
    $record = Read-ImportedDeckRecord $resolved
    if ($record.DeckId -ne $Id -or $record.SourceUrl -notmatch ('^https://archidekt\.com/decks/' + [regex]::Escape($Id) + '/?$')) { throw "Archidekt source identity changed." }
    if ((Get-FileHash -LiteralPath $resolved -Algorithm SHA256).Hash -ne $ExpectedHash) { throw "Deck changed locally during review. Run the update again." }
    [void](Get-ExactDeckSections $Lines)
    $backupFolder = Join-Path $BackupDir 'deck-updates'
    [void](New-Item -ItemType Directory -Path $backupFolder -Force)
    $backup = Join-Path $backupFolder ((Get-Date -Format 'yyyyMMdd-HHmmssfff') + '-' + [Guid]::NewGuid().ToString('N') + '-' + [IO.Path]::GetFileName($resolved))
    $temp = $resolved + '.' + [Guid]::NewGuid().ToString('N') + '.pending'
    try {
        Write-Utf8NoBom $temp $Lines
        if ((Get-FileHash -LiteralPath $resolved -Algorithm SHA256).Hash -ne $ExpectedHash) { throw "Deck changed locally before saving." }
        [IO.File]::Replace($temp, $resolved, $backup)
    } finally { if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Force } }
    return $backup
}

function Update-ExistingDecks {
    Write-UiBanner "UPDATE EXISTING DECKS" "Archidekt / compare / review / update"
    $profile = Prompt-Profile
    if (-not $profile) { return }
    $username = Parse-ProfileInput $profile
    Write-Host "  Most recently changed on this profile: [1] [2] [3] [4] [5]  [0] All" -ForegroundColor Cyan
    $limit = Read-IntegerWithDefault "  How many recent decks? (0 = all)" 0 5 5
    $filters = Read-AdvancedDeckFilters
    $review = Read-IntegerWithDefault "  [1] Review every change  [2] Apply previously verified decks automatically" 1 2 1
    Write-Host "  Matches Archidekt IDs, preserves filenames, and backs up every update." -ForegroundColor DarkGray
    Write-Host "  New decks and campaign versions are excluded. Recent = last updated, not created." -ForegroundColor DarkGray
    if ((Read-Host "  Check existing decks now? [Y/n]") -match '^(?i:n|no)$') { return }
    Start-Log 'update-existing'
    $baselineFile = Join-Path $ToolDir 'deck-update-baselines.json'
    $baselines = @{}
    if (Test-Path -LiteralPath $baselineFile) {
        try { $saved = Get-Content -LiteralPath $baselineFile -Raw -Encoding UTF8 | ConvertFrom-Json
            foreach ($property in $saved.PSObject.Properties) { $baselines[$property.Name] = [string]$property.Value }
        } catch { Write-Log 'Previous update checks could not be read. Changes will require review.' }
    }
    $metas = @(Get-ProfileUpdateCandidates $username $limit)
    Complete-UiProgress
    $library = Get-ImportedLibraryIndex
    $updated = 0; $same = 0; $skipped = 0; $failed = 0; $index = 0
    $oldSideboards = $Settings.PreserveSideboards; $oldTokens = $Settings.RemoveActualTokens; $oldResolve = $Settings.ResolveWithScryfall
    try {
        $Settings.PreserveSideboards = $true; $Settings.RemoveActualTokens = $false; $Settings.ResolveWithScryfall = $true
        foreach ($meta in $metas) {
            $index++; $id = [string]$meta.id; $name = [string]$meta.name
            Show-UiProgress 'Comparing decks' $index $metas.Count $name
            Complete-UiProgress
            try {
                if (Test-AdvancedMetaFilters $meta $filters) { $skipped++; continue }
                $matches = @($library.Records | Where-Object { $_.DeckId -eq $id })
                if ($matches.Count -ne 1) { $skipped++; Write-Log "  SKIP $name - missing or ambiguous local source ID"; continue }
                $record = $matches[0]
                if ($record.SourceMode -match '(?i)campaign|betting' -or $record.SourceUrl -notmatch ('^https://archidekt\.com/decks/' + [regex]::Escape($id) + '/?$')) { $skipped++; continue }
                $hash = (Get-FileHash -LiteralPath $record.Path -Algorithm SHA256).Hash
                $before = @(Get-Content -LiteralPath $record.Path -Encoding UTF8)
                $detail = Invoke-JsonGet ("https://archidekt.com/api/decks/" + $id + "/")
                if ([string](Get-Prop $detail 'id') -ne $id -or (Get-DeckOwnerName $detail $meta) -ine $username) { throw 'Deck ID or owner could not be verified.' }
                $prepared = Convert-Deck $detail $meta @{} -PreviewOnly -Exact100Only -StrictSource -SourceMode $record.SourceMode -Bracket $record.Bracket
                if ($prepared.Skipped -or $prepared.UnresolvedNames -gt 0 -or $prepared.CutCount -gt 0) { throw 'Deck could not be fully verified. Existing file was not changed.' }
                $oldType = if ($record.CommanderLabel) { 'Commander' } else { 'Constructed' }
                if ($prepared.DeckType -ne $oldType) { throw 'Deck format changed. Review and reimport this deck separately.' }
                if (Test-AdvancedDetailFilters $prepared $filters) { $skipped++; continue }
                $changes = @(Get-ExactDeckChanges $before $prepared.DeckLines)
                if ($changes.Count -eq 0) { $same++; Write-Log "  UNCHANGED $name"; $baselines[$id] = $hash; continue }
                Write-UiSection $name
                foreach ($change in $changes) {
                    $color = if ($change.Delta -gt 0) { 'Green' } else { 'Red' }
                    $sign = if ($change.Delta -gt 0) { '+' } else { '' }
                    Write-Host ("  " + $sign + $change.Delta + "  " + $change.Name + "  [" + $change.Section + "]") -ForegroundColor $color
                }
                if ([bool]$Settings.DryRun) { $skipped++; Write-Log '  PREVIEW ONLY - no file changed'; continue }
                if ($review -eq 1 -or -not $baselines.ContainsKey($id) -or $baselines[$id] -ne $hash) {
                    if ($review -eq 2) { Write-Host '  First update or locally edited deck: review required.' -ForegroundColor Yellow }
                    $answer = Read-Host '  Apply these changes? [y/N/q to finish]'
                    if ($answer -match '^(?i:q|quit)$') { break }
                    if ($answer -notmatch '^(?i:y|yes)$') { $skipped++; continue }
                }
                # Keep local metadata and display name; replace the playable card sections only.
                $nextLines = New-Object System.Collections.ArrayList
                $section = ''; $keptSections = @('main','commander','sideboard')
                foreach ($line in $before) {
                    if ($line -match '^\s*\[(.+)\]\s*$') { $section = $Matches[1].ToLowerInvariant() }
                    if ($section -notin $keptSections) { [void]$nextLines.Add($line) }
                }
                $section = ''
                foreach ($line in $prepared.DeckLines) {
                    if ($line -match '^\s*\[(.+)\]\s*$') { $section = $Matches[1].ToLowerInvariant() }
                    if ($section -in $keptSections) { [void]$nextLines.Add($line) }
                }
                $backup = Save-VerifiedDeckUpdate $record.Path $id $hash $nextLines.ToArray()
                $baselines[$id] = (Get-FileHash -LiteralPath $record.Path -Algorithm SHA256).Hash
                $updated++; Write-Log ("  UPDATED " + $name + " | Backup: " + $backup)
            } catch { $failed++; Write-Log ("  NOT CHANGED " + $name + " - " + $_.Exception.Message) }
        }
    } finally {
        $Settings.PreserveSideboards = $oldSideboards; $Settings.RemoveActualTokens = $oldTokens; $Settings.ResolveWithScryfall = $oldResolve
        Complete-UiProgress
        if (-not [bool]$Settings.DryRun) { Write-Utf8NoBom $baselineFile ($baselines | ConvertTo-Json -Depth 4) }
    }
    Write-UiSection 'Update / complete'
    Write-Host ("  " + $updated + " updated   " + $same + " unchanged   " + $skipped + " skipped   " + $failed + " failed") -ForegroundColor Cyan
    Write-Host ('  Backups: ' + (Join-Path $BackupDir 'deck-updates')) -ForegroundColor DarkGray
}

